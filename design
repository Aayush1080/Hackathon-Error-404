"""Builds MoriSafe's Android launcher icons and splash screens from the masters rendered by icon.html and
splash.html (rendered with headless Edge). Run from design/android:  python make_resources.py"""
from pathlib import Path
from PIL import Image

HERE = Path(__file__).resolve().parent
RES = HERE.parents[1] / "app" / "android" / "app" / "src" / "main" / "res"
DENS = {"mdpi": 1, "hdpi": 1.5, "xhdpi": 2, "xxhdpi": 3, "xxxhdpi": 4}

sq, rnd, fg = (Image.open(HERE / f"icon-{v}.png").convert("RGBA") for v in ("sq", "round", "fg"))
for d, k in DENS.items():
    folder = RES / f"mipmap-{d}"
    folder.mkdir(exist_ok=True)
    sq.resize((round(48 * k),) * 2, Image.LANCZOS).save(folder / "ic_launcher.png", optimize=True)
    rnd.resize((round(48 * k),) * 2, Image.LANCZOS).save(folder / "ic_launcher_round.png", optimize=True)
    fg.resize((round(108 * k),) * 2, Image.LANCZOS).save(folder / "ic_launcher_foreground.png", optimize=True)

master = Image.open(HERE / "splash-master.png").convert("RGB")
W, H = master.size


def cover(w, h):
    """Centre-crop the square master to w:h, then scale (the logo is centred, so it is never cut)."""
    if w / h < W / H:
        cw, ch = round(H * w / h), H
    else:
        cw, ch = W, round(W * h / w)
    left, top = (W - cw) // 2, (H - ch) // 2
    return master.crop((left, top, left + cw, top + ch)).resize((w, h), Image.LANCZOS)


n = 0
for f in RES.glob("drawable*/splash.png"):
    w, h = Image.open(f).size
    cover(w, h).save(f, optimize=True)
    n += 1
print(f"icons for {len(DENS)} densities, {n} splash screens written to {RES}")

