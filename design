<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>MoriSafe admin concept</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--ink:#0f1b2d;--mut:#64748b;--line:#e8edf3;--bg:#f5f7fb;--brand:#0e9f8f;--brand2:#2563eb;--red:#e5383b;--police:#1e3a8a;
  --fire:#ea580c;--flood:#2563eb;--acc:#dc2626;--debris:#92400e;--other:#7c3aed}
*{box-sizing:border-box;margin:0;padding:0}
body{width:1600px;height:1000px;font-family:"Plus Jakarta Sans",system-ui,sans-serif;color:var(--ink);overflow:hidden;
  background:radial-gradient(900px 500px at 0% 0%,#d6f5ef 0,transparent 60%),radial-gradient(900px 600px at 100% 100%,#dbe7ff 0,transparent 60%),#eef2f8;padding:36px 48px}
.cap{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px}
.cap h1{font-size:30px;font-weight:800;letter-spacing:-.02em}.cap h1 span{background:linear-gradient(90deg,var(--brand),var(--brand2));-webkit-background-clip:text;color:transparent}
.cap p{color:var(--mut);font-size:14px;margin-top:4px}
.win{height:860px;border-radius:22px;background:#fff;box-shadow:0 40px 90px -30px rgba(15,27,45,.4);overflow:hidden;display:flex;flex-direction:column;border:1px solid #fff}
.bar{height:42px;background:#f1f4f9;display:flex;align-items:center;gap:8px;padding:0 16px;border-bottom:1px solid var(--line)}
.bar i{width:12px;height:12px;border-radius:50%}.url{margin-left:22px;background:#fff;border-radius:9px;padding:5px 14px;font-size:12px;color:var(--mut);width:360px;border:1px solid var(--line)}
.app{flex:1;display:flex;min-height:0}
.side{width:236px;background:linear-gradient(180deg,#0f1b2d,#13284a);color:#cbd5e1;padding:20px 14px;display:flex;flex-direction:column}
.brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:800;font-size:18px;margin:0 6px 26px}
.logo{width:36px;height:36px;border-radius:11px;background:linear-gradient(135deg,var(--brand),var(--brand2));display:grid;place-items:center}
.nav a{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:12px;font-size:13.5px;font-weight:600;margin-bottom:3px}
.nav a.on{background:rgba(255,255,255,.1);color:#fff;box-shadow:inset 3px 0 0 #2dd4bf}
.nav a b{margin-left:auto;font-size:11px;background:#f97316;color:#fff;border-radius:999px;padding:1px 8px}
.nav small{display:block;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;margin:16px 12px 8px;font-weight:700}
.me{margin-top:auto;background:rgba(255,255,255,.06);border-radius:14px;padding:12px;display:flex;gap:10px;align-items:center;font-size:12.5px}
.me .av{width:34px;height:34px;border-radius:50%;background:#2dd4bf;color:#0f1b2d;font-weight:800;display:grid;place-items:center}
.main{flex:1;background:var(--bg);padding:22px 26px;min-width:0;display:flex;flex-direction:column;gap:18px}
.head{display:flex;align-items:center;gap:14px}
.head h2{font-size:22px;font-weight:800;letter-spacing:-.02em}.head p{font-size:12.5px;color:var(--mut);margin-top:2px}
.search{margin-left:auto;width:320px;height:40px;border-radius:12px;background:#fff;border:1px solid var(--line);display:flex;align-items:center;gap:8px;padding:0 12px;font-size:13px;color:#94a3b8}
.search kbd{margin-left:auto;font-family:inherit;font-size:11px;background:#f1f5f9;border-radius:6px;padding:2px 6px}
.ibtn{width:40px;height:40px;border-radius:12px;background:#fff;border:1px solid var(--line);display:grid;place-items:center;position:relative}
.ibtn:after{content:"";position:absolute;top:9px;right:10px;width:8px;height:8px;border-radius:50%;background:var(--red);border:2px solid #fff}
.live{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#047857;background:#ecfdf5;border-radius:999px;padding:7px 12px}
.live i{width:8px;height:8px;border-radius:50%;background:#10b981;box-shadow:0 0 0 4px rgba(16,185,129,.2)}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.kpi{background:#fff;border-radius:18px;padding:16px;border:1px solid var(--line);position:relative;overflow:hidden}
.kpi .l{font-size:12.5px;font-weight:600;color:var(--mut);display:flex;align-items:center;gap:8px}
.kpi .l span{width:28px;height:28px;border-radius:9px;display:grid;place-items:center}
.kpi .v{font-size:30px;font-weight:800;letter-spacing:-.02em;margin-top:10px}
.kpi .d{font-size:11.5px;font-weight:700;margin-top:2px}
.kpi svg.sp{position:absolute;right:14px;bottom:16px}
.cols{display:grid;grid-template-columns:1fr 400px;gap:18px;flex:1;min-height:0}
.card{background:#fff;border-radius:18px;border:1px solid var(--line);padding:16px;min-height:0}
.ch{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.ch h3{font-size:15.5px;font-weight:800}.ch .n{font-size:12px;color:var(--mut);font-weight:600}
.tabs{margin-left:auto;display:flex;background:#f1f5f9;border-radius:11px;padding:3px}
.tabs span{font-size:12px;font-weight:700;padding:6px 12px;border-radius:8px;color:var(--mut)}.tabs .on{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.08)}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#94a3b8;font-weight:700;padding:8px 10px;border-bottom:1px solid var(--line)}
td{padding:11px 10px;white-space:nowrap;border-bottom:1px solid #f1f4f8;vertical-align:middle}
tr.sel td{background:#f8fbff}
td:first-child{white-space:normal}.inc{display:flex;align-items:center;gap:11px}.inc b{display:block;font-size:13.5px}.inc small{color:var(--mut);font-size:11.5px}
.ic{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;flex:none}
.pill{font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.p-pol{background:#e0e7ff;color:var(--police)}.p-cit{background:#ecfdf5;color:#047857}.p-mer{background:#f3e8ff;color:#6d28d9}
.p-pen{background:#fff7ed;color:#c2410c}.p-app{background:#ecfdf5;color:#047857}.p-gone{background:#fef3c7;color:#92400e}
.who{font-size:12.5px}.who small{display:block;color:var(--mut);font-size:11px}
.btn{font-size:12px;font-weight:700;padding:7px 12px;border-radius:10px;border:1px solid var(--line);background:#fff;white-space:nowrap}
.btn.pri{background:var(--ink);color:#fff;border-color:var(--ink)}
.right{display:flex;flex-direction:column;gap:18px;min-height:0}
.map{height:218px;border-radius:14px;overflow:hidden;position:relative}
.poi{position:absolute;width:18px;height:18px;border-radius:6px;border:2px solid #fff;box-shadow:0 2px 5px rgba(0,0,0,.3)}
.pin{position:absolute;width:30px;height:30px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:grid;place-items:center;border:2.5px solid #fff;box-shadow:0 5px 10px rgba(0,0,0,.3)}
.pin svg{transform:rotate(45deg)}
.leg{display:flex;gap:12px;flex-wrap:wrap;font-size:11.5px;color:var(--mut);font-weight:600;margin-top:10px}
.leg span{display:flex;align-items:center;gap:5px}.leg i{width:10px;height:10px;border-radius:3px}
.feed li{list-style:none;display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #f1f4f8;font-size:12.5px}
.feed li:last-child{border:0}.feed .dot{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;flex:none;font-size:13px}
.feed small{display:block;color:var(--mut);font-size:11px;margin-top:1px}
</style>
</head>
<body>
<div class="cap">
  <div><h1><span>MoriSafe</span> admin · UI refresh concept</h1><p>Review queue first, live map beside it, merged duplicates and passer-by answers visible at a glance.</p></div>
</div>
<div class="win">
  <div class="bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><div class="url">🔒 morisafe.mu/admin</div></div>
  <div class="app">
    <aside class="side">
      <div class="brand"><div class="logo"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l7.5 3v5.5c0 5-3.5 8.6-7.5 10.5-4-1.9-7.5-5.5-7.5-10.5V5.5z"/><path d="M9 12l2 2 4-4"/></svg></div>MoriSafe</div>
      <nav class="nav">
        <a class="on"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/></svg>Overview</a>
        <a><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>Review queue<b>4</b></a>
        <a><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/></svg>Incident map</a>
        <a><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>Analytics</a>
        <small>Manage</small>
        <a><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="M16 4a4 4 0 0 1 0 8M22 21a7 7 0 0 0-5-6.7"/></svg>Citizen accounts</a>
        <a><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>Audit log</a>
        <a><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>Settings</a>
      </nav>
      <div class="me"><div class="av">AS</div><div><b style="color:#fff">Aayush S.</b><div style="font-size:11px;color:#94a3b8">Administrator</div></div></div>
    </aside>

    <main class="main">
      <div class="head">
        <div><h2>Good morning, Aayush</h2><p>Saturday 14 November · 4 reports waiting for review</p></div>
        <div class="search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>Search reports, places, people<kbd>Ctrl K</kbd></div>
        <span class="live"><i></i>Live</span>
        <div class="ibtn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0f1b2d" stroke-width="2" stroke-linecap="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></div>
      </div>

      <div class="kpis">
        <div class="kpi"><div class="l"><span style="background:#fff7ed;color:#c2410c">⏳</span>Waiting for review</div><div class="v">4</div><div class="d" style="color:#c2410c">2 new in the last hour</div>
          <svg class="sp" width="90" height="34"><path d="M0 28 L15 24 L30 26 L45 16 L60 18 L75 8 L90 4" fill="none" stroke="#f97316" stroke-width="2.5" stroke-linecap="round"/></svg></div>
        <div class="kpi"><div class="l"><span style="background:#ecfdf5;color:#047857">📡</span>Live on the app</div><div class="v">3</div><div class="d" style="color:#047857">Published, under 20 h old</div>
          <svg class="sp" width="90" height="34"><path d="M0 20 L15 22 L30 14 L45 18 L60 10 L75 14 L90 8" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round"/></svg></div>
        <div class="kpi"><div class="l"><span style="background:#f3e8ff;color:#6d28d9">⧉</span>Duplicates merged</div><div class="v">7</div><div class="d" style="color:#6d28d9">Saved 7 separate reviews</div>
          <svg class="sp" width="90" height="34"><path d="M0 30 L15 26 L30 27 L45 20 L60 16 L75 12 L90 10" fill="none" stroke="#8b5cf6" stroke-width="2.5" stroke-linecap="round"/></svg></div>
        <div class="kpi"><div class="l"><span style="background:#e0ecff;color:#1d4ed8">⚡</span>Median review time</div><div class="v">6 min</div><div class="d" style="color:#047857">▼ 3 min vs last week</div>
          <svg class="sp" width="90" height="34"><path d="M0 6 L15 10 L30 8 L45 16 L60 14 L75 22 L90 24" fill="none" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round"/></svg></div>
      </div>

      <div class="cols">
        <div class="card">
          <div class="ch"><h3>Review queue</h3><span class="n">4 incidents · 9 reports</span>
            <div class="tabs"><span class="on">All</span><span>Citizen</span><span>Police</span></div></div>
          <table>
            <tr><th>Incident</th><th>Reported by</th><th>Signals</th><th>Received</th><th>Status</th><th></th></tr>
            <tr class="sel"><td><div class="inc"><div class="ic" style="background:#fff1e8"><svg width="20" height="20" viewBox="0 0 24 24" fill="var(--fire)"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg></div><div><b>Fire · Sugar cane field</b><small>Médine Camp de Masque</small></div></div></td>
              <td><div class="who"><span class="pill p-pol">🛡 Police</span><small>Sgt. R. Ramgoolam</small></div></td>
              <td><span class="pill p-mer">⧉ 3 reports merged</span></td><td>12 min ago</td><td><span class="pill p-pen">● Pending</span></td><td><span class="btn pri">Review</span></td></tr>
            <tr><td><div class="inc"><div class="ic" style="background:#fee2e2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--acc)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16.5V13l2-5h12l2 5v3.5z"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/></svg></div><div><b>Accident · M1 Motorway</b><small>Réduit, near the roundabout</small></div></div></td>
              <td><div class="who"><span class="pill p-cit">✓ Citizen</span><small>Nidhish M.</small></div></td>
              <td><span class="pill p-mer">⧉ 2 merged</span></td><td>26 min ago</td><td><span class="pill p-pen">● Pending</span></td><td><span class="btn">Review</span></td></tr>
            <tr><td><div class="inc"><div class="ic" style="background:#e8f0ff"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--flood)" stroke-width="2.2" stroke-linecap="round"><path d="M2 9c.6.5 1.2 1 2.5 1C7 10 7 8 9.5 8c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 15c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg></div><div><b>Flooding · Coastal Road</b><small>Flic en Flac</small></div></div></td>
              <td><div class="who"><span class="pill p-cit">✓ Citizen</span><small>Tushar D.</small></div></td>
              <td><span class="pill p-gone">👎 3 say it's gone</span></td><td>48 min ago</td><td><span class="pill p-app">● Live</span></td><td><span class="btn">Resolve</span></td></tr>
            <tr><td><div class="inc"><div class="ic" style="background:#fdf1e7"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--debris)" stroke-width="2.4" stroke-linecap="round"><path d="M3 20h18M5 20l4-7 3 3 3-5 4 9"/></svg></div><div><b>Falling debris · Rue Desforges</b><small>Port Louis</small></div></div></td>
              <td><div class="who"><span class="pill p-cit">✓ Citizen</span><small>Anonymous device</small></div></td>
              <td><span style="color:#94a3b8;font-size:12px">—</span></td><td>2 h ago</td><td><span class="pill p-pen">● Pending</span></td><td><span class="btn">Review</span></td></tr>
            <tr><td><div class="inc"><div class="ic" style="background:#f3e8ff"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--other)" stroke-width="2.4" stroke-linecap="round"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg></div><div><b>Fallen tree · Royal Road</b><small>Curepipe</small></div></div></td>
              <td><div class="who"><span class="pill p-cit">✓ Citizen</span><small>Kavya P.</small></div></td>
              <td><span style="color:#94a3b8;font-size:12px">—</span></td><td>3 h ago</td><td><span class="pill p-pen">● Pending</span></td><td><span class="btn">Review</span></td></tr>
          </table>
        </div>

        <div class="right">
          <div class="card">
            <div class="ch"><h3>Live map</h3><span class="n">Incidents & emergency services</span></div>
            <div class="map">
              <svg viewBox="0 0 368 262" width="100%" height="218" preserveAspectRatio="xMidYMid slice">
                <defs><pattern id="w" width="18" height="18" patternUnits="userSpaceOnUse"><path d="M0 9c3-3 6-3 9 0s6 3 9 0" stroke="#b9dcf0" stroke-width="1" fill="none"/></pattern></defs>
                <rect width="368" height="262" fill="#cfe7f5"/><rect width="368" height="262" fill="url(#w)" opacity=".6"/>
                <path d="M160 18c28-4 58 6 74 28 15 20 12 42 27 63 17 26 19 61 8 91-8 24-4 47-14 72-13 35-42 60-80 66-34 5-60-8-75-34-14-24-20-48-23-75-3-34-15-54-7-86 8-32 20-54 40-74 15-15 30-48 50-51z" fill="#e9f3e6" stroke="#d4e6cf" stroke-width="2" transform="translate(0,-28)"/>
                <path d="M150 40c20 20 40 40 47 80s-13 74 7 114M95 150c40-7 80 7 135 0" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round"/>
              </svg>
              <div class="pin" style="left:150px;top:96px;background:var(--fire)"><svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg></div>
              <div class="pin" style="left:110px;top:140px;background:var(--flood)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M2 9c3 2 5-2 10 0s7-2 10 0M2 15c3 2 5-2 10 0s7-2 10 0"/></svg></div>
              <div class="pin" style="left:190px;top:120px;background:var(--acc)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><path d="M4 16.5V13l2-5h12l2 5v3.5z"/></svg></div>
              <div class="pin" style="left:168px;top:40px;background:var(--debris)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M3 20h18M5 20l4-7 3 3 3-5 4 9"/></svg></div>
