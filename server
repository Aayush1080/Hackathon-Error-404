ADMIN_COLS = f"*,{PHOTO_COLS},users(full_name,nid_masked,role)"
PUBLIC_URL_TTL, ADMIN_URL_TTL = 3600, 900
# What a reviewer confirms before publishing. The dashboard shows the same list (ConfirmActionModal.jsx).
CHECKLIST = ("photo", "location", "category", "content", "not_duplicate", "current")
LOCKOUT_AFTER, LOCKOUT_MIN = 5, 15
REPORT_RADIUS_KM = 0.5  # a report's location must be this close to the reporter's own position


def _public_rows(category: str | None = None, report_id: str | None = None):
    since = (now_utc() - timedelta(hours=CURRENT_HOURS)).isoformat()
    q = (db().table("reports").select(f"*,{PHOTO_COLS}").eq("status", "approved").gte("approved_at", since)
         .is_("duplicate_of", "null"))
    if category:
        q = q.eq("category", category)
    if report_id:
        q = q.eq("id", report_id)
    return q.order("approved_at", desc=True).limit(500).execute().data


def _validate_category(category: str, custom: str | None) -> tuple[str, str | None]:
    if category not in CATEGORIES:
        raise ApiError(422, "validation_error", "Choose an incident type.", [{"field": "category", "message": f"one of {', '.join(CATEGORIES)}"}])
    if category == "Other":
        return category, clean_text(custom, "Incident description", 60, required=True)
    return category, None


def _validate_point(lat, lng) -> None:
    if not in_mauritius(lat, lng):
        raise ApiError(422, "outside_mauritius", "The incident location must be in Mauritius.",
                       [{"field": "latitude/longitude", "message": "outside Mauritius"}])


def _translate_items(items: list[dict], lang: str | None) -> None:
    """Adds the description (and an "Other" incident name) in the reader's language. The original stays
    available as description_original."""
    if not lang or lang not in LANGS or not items:
        return
    texts = [i["description"] for i in items] + [i["custom_category"] for i in items if i.get("custom_category")]
    tr = translate_many(texts, lang)
    for i in items:
        d = i["description"]
        if d and tr.get(d, d) != d:
            i["description_original"], i["description"], i["translated"] = d, tr[d], True
        c = i.get("custom_category")
        if c and tr.get(c, c) != c:
            i["label"], i["translated"] = tr[c], True


# ================================================================ public
@router.get("/health")
def health():
    try:
        db().table("reports").select("id").limit(1).execute()
        return {"status": "ok", "database": "ok"}
    except Exception as exc:
        log.error("health check failed: %s", exc)
