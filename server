@router.patch("/admin/reports/{report_id}")
def admin_edit(report_id: uuid.UUID, body: EditIn, admin: Admin = Depends(require("edit"))):
    row = _get_row(report_id)
    fields = body.model_dump(exclude_unset=True)
    patch: dict = {}
    if "category" in fields or "custom_category" in fields:
        cat = fields.get("category") or row["category"]
        cat, custom = _validate_category(cat, fields.get("custom_category", row.get("custom_category")))
        patch.update(category=cat, custom_category=custom)
    if "description" in fields:
        patch["description"] = clean_text(fields["description"], "Description", 500, multiline=True) or ""
    if "location_name" in fields:
        patch["location_name"] = clean_text(fields["location_name"], "Location", 160, required=True)
    if "latitude" in fields or "longitude" in fields:
        lat, lng = fields.get("latitude", row["latitude"]), fields.get("longitude", row["longitude"])
        _validate_point(lat, lng)
        patch.update(latitude=float(lat), longitude=float(lng))
    if "town" in fields:
        patch["town"] = fields["town"] if fields["town"] in TOWNS else "Other"
    elif "location_name" in patch:
        patch["town"] = match_town(patch["location_name"])
    if fields.get("observed_time"):
        patch["observed_at"] = observed_at_from_hhmm(fields["observed_time"], parse_ts(row["created_at"])).isoformat()
        patch["observed_time"] = fields["observed_time"].strip()
    changes = {k: {"from": row.get(k), "to": v} for k, v in patch.items()
               if str(row.get(k)) != str(v) and k != "observed_at"}
    if not changes:
        return {"report": _detail(report_id), "changed": False}
    merged = {**row, **patch}
    patch["title"] = f"{label(merged)} - {merged.get('location_name') or 'Mauritius'}"[:200]
    db().table("reports").update(patch).eq("id", str(report_id)).execute()
    _audit(admin, report_id, "edit", row["status"], row["status"], changes)
    return {"report": _detail(report_id), "changed": True}


