def register(body: RegisterIn, request: Request, x_human_proof: str | None = Header(default=None)):
    limiter.hit(f"register:ip:{client_ip(request)}", 10, 3600)
    nid = validate_nid(body.nid)
    name = clean_text(body.full_name, "Full name", 80, required=True)
    if len(name) < 2 or not any(ch.isalpha() for ch in name):
        raise ApiError(422, "validation_error", "Enter your full name.", [{"field": "full_name", "message": "required"}])
    phone = None
    if body.phone and body.phone.strip():
        digits = "".join(ch for ch in body.phone if ch.isdigit())
        digits = digits[3:] if digits.startswith("230") and len(digits) > 8 else digits
        if not 7 <= len(digits) <= 8:
            raise ApiError(422, "validation_error", "Enter a 7 or 8 digit Mauritius phone number.", [{"field": "phone", "message": "format"}])
        phone = "+230 " + digits
    check_password(body.password, nid)
    verify_human(x_human_proof, "register")
    h = nid_hash(nid)
    taken = ApiError(409, "nid_registered", "An account with this NID already exists. Sign in instead.")
    if db().table("users").select("id").eq("nid_hash", h).limit(1).execute().data:
        raise taken
    try:
        row = db().table("users").insert({"nid_hash": h, "nid_masked": nid_masked(nid), "full_name": name, "phone": phone,
                                          "password_hash": hash_password(body.password),
                                          "last_login_at": now_utc().isoformat()}).execute().data[0]
    except Exception as exc:
        if "duplicate" in str(exc).lower() or "23505" in str(exc):
            raise taken
        raise
    log.info("citizen account %s created", row["id"])
    return issue_user_token(user_from_row(row))


