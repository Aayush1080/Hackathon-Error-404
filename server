def _get_row(report_id) -> dict:
    rows = db().table("reports").select(ADMIN_COLS).eq("id", str(report_id)).limit(1).execute().data
    if not rows:
        raise ApiError(404, "not_found", "Report not found. It may have been deleted.")
    return rows[0]


def _children(report_id) -> list[dict]:
    return db().table("reports").select(ADMIN_COLS).eq("duplicate_of", str(report_id)).order("created_at").execute().data


def _feedback(ids: list[str]) -> dict[str, dict]:
    out: dict[str, dict] = {}
    if not ids:
        return out
    for i in range(0, len(ids), 150):
        for f in db().table("report_feedback").select("report_id,still_there").in_("report_id", ids[i:i + 150]).execute().data:
            c = out.setdefault(f["report_id"], {"still_there": 0, "gone": 0})
            c["still_there" if f["still_there"] else "gone"] += 1
    return out


def _group_items(rows: list[dict], urls: dict[str, str]) -> list[dict]:
    """One item per incident: merged duplicates are nested under the report they were merged into."""
    ids = {r["id"] for r in rows}
    kids: dict[str, list[dict]] = {}
    tops = []
    for r in rows:
        if r.get("duplicate_of") and r["duplicate_of"] in ids:
            kids.setdefault(r["duplicate_of"], []).append(r)
        else:
            tops.append(r)
    fb = _feedback([r["id"] for r in tops if r["status"] == "approved"])
    items = []
    for r in tops:
        item = admin_item(r, urls)
        dups = sorted(kids.get(r["id"], []), key=lambda x: x["created_at"])
        item["duplicates"] = [admin_item(d, urls) for d in dups]
        item["pending_duplicates"] = sum(1 for d in dups if d["status"] == "pending")
        item["feedback"] = fb.get(r["id"], {"still_there": 0, "gone": 0})
        items.append(item)
    return items


@router.get("/admin/reports")
def admin_list(status: str | None = None, admin: Admin = Depends(require("read"))):
    if status and status not in STATUSES:
        raise ApiError(422, "validation_error", "Unknown status.")
    q = db().table("reports").select(ADMIN_COLS)
    rows = q.order("created_at", desc=True).limit(2000).execute().data
    urls = signed_urls(photo_paths(rows), ADMIN_URL_TTL)
    items = _group_items(rows, urls)
    if status:
        items = [i for i in items if i["status"] == status or (status == "pending" and i["pending_duplicates"])]
    stats = {s: sum(1 for i in items if i["status"] == s) for s in STATUSES}
    return {"server_time": now_utc().isoformat(), "reports": items, "stats": {"total": len(items), **stats},
            "checklist": list(CHECKLIST)}


def _detail(report_id) -> dict:
    row = _get_row(report_id)
    rows = [row] + _children(report_id)
    item = _group_items(rows, signed_urls(photo_paths(rows), ADMIN_URL_TTL))[0]
    return item


