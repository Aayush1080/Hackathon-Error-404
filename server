MU_TZ = ZoneInfo("Indian/Mauritius")
CATEGORIES = ("Falling debris", "Accident", "Fire", "Flooding", "Other")
STATUSES = ("pending", "approved", "rejected", "resolved", "archived")
SOURCES = ("citizen", "police")
TOWNS = ("Port Louis", "Curepipe", "Quatre Bornes", "Vacoas-Phoenix", "Rose Hill", "Beau Bassin", "Mahébourg",
         "Flic en Flac", "Grand Baie", "Triolet", "Goodlands", "Moka", "Centre de Flacq", "Saint Pierre", "Souillac")
LAT_MIN, LAT_MAX, LNG_MIN, LNG_MAX = -20.65, -19.85, 57.18, 58.1  # same box as the DB constraint
CURRENT_HOURS, OLDER_HOURS = 20, 12   # public for 20 h after approval, dimmed after 12 h
DUPLICATE_KM, NEAR_KM = 0.5, 10


def now_utc() -> datetime:
    return datetime.now(timezone.utc)


def parse_ts(v) -> datetime | None:
    return datetime.fromisoformat(v) if isinstance(v, str) and v else v


def in_mauritius(lat, lng) -> bool:
    try:
        lat, lng = float(lat), float(lng)
    except (TypeError, ValueError):
        return False
    return math.isfinite(lat) and math.isfinite(lng) and LAT_MIN <= lat <= LAT_MAX and LNG_MIN <= lng <= LNG_MAX


def distance_km(lat1, lng1, lat2, lng2) -> float:
    r = math.pi / 180
    h = math.sin((lat2 - lat1) * r / 2) ** 2 + math.cos(lat1 * r) * math.cos(lat2 * r) * math.sin((lng2 - lng1) * r / 2) ** 2
    return 6371 * 2 * math.atan2(math.sqrt(h), math.sqrt(1 - h))


def _norm(s: str) -> str:
    return "".join(c for c in unicodedata.normalize("NFD", s) if unicodedata.category(c) != "Mn").lower()


def match_town(name: str | None) -> str:
    """Same rule as the prototype's matchTown()."""
    if not name:
        return "Other"
    x = _norm(name)
    return next((t for t in TOWNS if _norm(t) in x or (len(x) > 3 and x in _norm(t))), "Other")


def clean_text(value, field: str, max_len: int, required: bool = False, multiline: bool = False) -> str | None:
    """Strips control characters. Clients HTML-escape on output; the API stores plain text."""
    s = "" if value is None else str(value)
    s = "".join(ch for ch in s if ch in ("\n",) and multiline or unicodedata.category(ch)[0] != "C")
    s = re.sub(r"[ \t]+", " ", s).strip() if not multiline else re.sub(r"\n{3,}", "\n\n", s).strip()
    if required and not s:
        raise ApiError(422, "validation_error", f"{field} is required.", [{"field": field, "message": "required"}])
    if len(s) > max_len:
        raise ApiError(422, "validation_error", f"{field} must be {max_len} characters or fewer.",
                       [{"field": field, "message": f"max {max_len} characters"}])
    return s or None


def observed_at_from_hhmm(hhmm: str, now: datetime | None = None) -> datetime:
    """'HH:MM' Mauritius time -> the latest such moment at or before now (23:59 sent at 00:30 = yesterday)."""
    m = re.fullmatch(r"([01]\d|2[0-3]):([0-5]\d)", (hhmm or "").strip())
    if not m:
        raise ApiError(422, "validation_error", "Time observed must be HH:MM.", [{"field": "observed_time", "message": "HH:MM"}])
    local_now = (now or now_utc()).astimezone(MU_TZ)
    t = local_now.replace(hour=int(m[1]), minute=int(m[2]), second=0, microsecond=0)
    if t > local_now:
        t -= timedelta(days=1)
    return t.astimezone(timezone.utc)


def label(row: dict) -> str:
    return (row.get("custom_category") if row.get("category") == "Other" and row.get("custom_category") else row.get("category")) or "Incident"


# ---------------------------------------------------------------- photos
ALLOWED_FORMATS = {"JPEG", "MPO", "PNG", "WEBP", "HEIF"}
MAX_PIXELS = 50_000_000
MAX_EDGE = 1600
Image.MAX_IMAGE_PIXELS = MAX_PIXELS


@dataclass
class Photo:
    data: bytes
    width: int
    height: int
    sha256: str


def process_photo(data: bytes) -> Photo:
    """Decodes the real file contents (the filename and declared type are ignored), rejects anything that
    is not a photo, applies EXIF rotation, then re-encodes as a fresh JPEG with no metadata, which also
    removes the camera's GPS tags and anything appended to the file."""
    if len(data) < 64:
        raise ApiError(422, "invalid_photo", "The photo is empty or damaged. Choose another photo.")
    try:
        with warnings.catch_warnings():
            warnings.simplefilter("error", Image.DecompressionBombWarning)
            with Image.open(io.BytesIO(data)) as probe:
                fmt = probe.format
                probe.verify()
            if fmt not in ALLOWED_FORMATS:
                raise ApiError(415, "unsupported_photo_type", "Photos must be JPEG, PNG, WebP or HEIC.")
            img = Image.open(io.BytesIO(data))
            img.load()
    except ApiError:
        raise
    except (UnidentifiedImageError, Image.DecompressionBombError, Image.DecompressionBombWarning, OSError, SyntaxError, ValueError):
        raise ApiError(415, "unsupported_photo_type", "That file is not a photo we can read. Use a JPEG, PNG, WebP or HEIC photo.")
    img = ImageOps.exif_transpose(img)
    if img.mode in ("RGBA", "LA", "P"):
        img = img.convert("RGBA")
        bg = Image.new("RGB", img.size, (255, 255, 255))
        bg.paste(img, mask=img.getchannel("A"))
        img = bg
    img = img.convert("RGB")
    img.thumbnail((MAX_EDGE, MAX_EDGE), Image.LANCZOS)
    out = io.BytesIO()
    img.save(out, "JPEG", quality=82, optimize=True)
    raw = out.getvalue()
    return Photo(raw, img.width, img.height, hashlib.sha256(raw).hexdigest())


def store_photo(photo: Photo) -> str:
    path = f"{now_utc():%Y/%m}/{uuid.uuid4().hex}.jpg"
    try:
        db().storage.from_(settings().photo_bucket).upload(path, photo.data, {"content-type": "image/jpeg", "cache-control": "3600"})
    except Exception as exc:
        log.error("photo upload failed: %s", exc)
        raise ApiError(502, "storage_unavailable", "The photo could not be saved. Your report was not sent. Try again.")
    return path


