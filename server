    if not rows:
        burn_password_time(body.password)
        raise wrong
    u = rows[0]
    now = now_utc()
    if u.get("locked_until") and parse_ts(u["locked_until"]) > now:
        mins = max(1, round((parse_ts(u["locked_until"]) - now).total_seconds() / 60))
        raise ApiError(429, "account_locked", f"Too many wrong passwords. Try again in {mins} minute{'s' if mins > 1 else ''}.")
    if not verify_password(body.password, u["password_hash"]):
        fails = (u.get("failed_logins") or 0) + 1
        patch = {"failed_logins": fails}
        if fails >= LOCKOUT_AFTER:
            patch = {"failed_logins": 0, "locked_until": (now + timedelta(minutes=LOCKOUT_MIN)).isoformat()}
        db().table("users").update(patch).eq("id", u["id"]).execute()
        raise wrong
    if u.get("disabled"):
        raise ApiError(403, "account_disabled", "This account has been disabled. Contact MoriSafe support.")
    db().table("users").update({"failed_logins": 0, "locked_until": None, "last_login_at": now.isoformat()}).eq("id", u["id"]).execute()
