    shown = {"pending": "pending", "approved": "approved", "rejected": "not published",
             "resolved": "resolved", "archived": "not published"}
    return {"reports": [{"id": r["id"], "label": label(r), "category": r["category"], "location_name": r["location_name"],
                         "status": shown[r["status"]], "merged": bool(r.get("duplicate_of")),
