"""Configuration, Supabase access, error format, admin sessions, device identity and rate limits."""
from __future__ import annotations

import base64
import hashlib
import hmac
import logging
import os
import re
import secrets
import threading
import time
from dataclasses import dataclass
from datetime import date
from functools import lru_cache

import httpx
import jwt
from fastapi import Depends, Header, Request
from supabase import Client, create_client

log = logging.getLogger("morisafe")

DEFAULT_ORIGINS = [
    "https://localhost",      # Capacitor Android
    "capacitor://localhost",  # Capacitor iOS
    "http://localhost",
    "http://localhost:5173",  # admin dashboard (vite dev)
    "http://localhost:5174",  # public app (vite dev)
]


@dataclass(frozen=True)
class Settings:
    supabase_url: str
    service_key: str
    app_secret: str
    allowed_origins: tuple[str, ...]
    photo_bucket: str
    session_hours: float
    max_upload_bytes: int
    firebase_credentials: str | None
    rate_limits: bool
    human_check: bool

    @classmethod
    def from_env(cls) -> "Settings":
        missing = [k for k in ("SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY", "APP_SECRET") if not os.getenv(k)]
        if missing:
            raise RuntimeError(f"Missing required environment variables: {', '.join(missing)}. See .env.example.")
        secret = os.environ["APP_SECRET"]
        if len(secret) < 32:
            raise RuntimeError("APP_SECRET must be at least 32 characters (python -c \"import secrets; print(secrets.token_urlsafe(48))\").")
        origins = [o.strip().rstrip("/") for o in os.getenv("ALLOWED_ORIGINS", "").split(",") if o.strip()]
        return cls(
            supabase_url=os.environ["SUPABASE_URL"].rstrip("/"),
            service_key=os.environ["SUPABASE_SERVICE_ROLE_KEY"],
            app_secret=secret,
            allowed_origins=tuple(origins or DEFAULT_ORIGINS),
            photo_bucket=os.getenv("PHOTO_BUCKET", "report-photos"),
            session_hours=float(os.getenv("ADMIN_SESSION_HOURS", "8")),
            max_upload_bytes=int(os.getenv("MAX_UPLOAD_MB", "10")) * 1024 * 1024,
            firebase_credentials=os.getenv("FIREBASE_SERVICE_ACCOUNT") or None,
            rate_limits=os.getenv("RATE_LIMITS", "on").lower() != "off",
            human_check=os.getenv("HUMAN_CHECK", "on").lower() != "off",
        )


@lru_cache
def settings() -> Settings:
    return Settings.from_env()


@lru_cache
def db() -> Client:
    """Service-role client. Server-side only; never call auth.sign_in* on it
    (supabase-py would then reuse the signed-in user's token for every query)."""
    s = settings()
    return create_client(s.supabase_url, s.service_key)


# ---------------------------------------------------------------- errors
class ApiError(Exception):
    """Every error response has the shape {"error": {"code", "message", "details"}}."""

    def __init__(self, status: int, code: str, message: str, details=None, headers: dict | None = None):
        super().__init__(message)
        self.status, self.code, self.message, self.details, self.headers = status, code, message, details, headers


# ---------------------------------------------------------------- devices
_UUID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")


def device_hash(device_id: str | None) -> str | None:
    """The app sends a random UUID it generated (X-Device-Id). Only an HMAC of it is stored,
    so reports can be grouped and rate-limited per device without identifying anyone."""
    if not device_id or not _UUID.match(device_id):
        return None
    return hmac.new(settings().app_secret.encode(), b"device:" + device_id.lower().encode(), hashlib.sha256).hexdigest()


def client_ip(request: Request) -> str:
    # Behind a proxy (Render, Railway...), run uvicorn with --proxy-headers so this is the real client.
    return request.client.host if request.client else "unknown"


# ---------------------------------------------------------------- rate limits
class RateLimiter:
    """In-memory sliding window. Per process: fine for one server instance."""

    def __init__(self):
        self._hits: dict[str, list[float]] = {}
        self._lock = threading.Lock()

    def hit(self, key: str, limit: int, window_s: int) -> None:
        if not settings().rate_limits:
            return
        now = time.monotonic()
        with self._lock:
            if len(self._hits) > 20000:
                self._hits = {k: v for k, v in self._hits.items() if v and now - v[-1] < 3600}
            q = [t for t in self._hits.get(key, []) if now - t < window_s]
            if len(q) >= limit:
                retry = int(window_s - (now - q[0])) + 1
                self._hits[key] = q
                raise ApiError(429, "rate_limited", f"Too many requests. Try again in {retry} seconds.",
                               {"retry_after": retry}, {"Retry-After": str(retry)})
            q.append(now)
            self._hits[key] = q

    def reset(self) -> None:
        with self._lock:
            self._hits.clear()


limiter = RateLimiter()


# ---------------------------------------------------------------- admin sessions
@dataclass(frozen=True)
class Admin:
    id: str
    email: str | None
    full_name: str | None
    role: str

    @property
    def perms(self) -> set[str]:
        return ROLE_PERMS.get(self.role, {"read"})

    def public(self) -> dict:
        return {"id": self.id, "email": self.email, "full_name": self.full_name, "role": self.role,
                "permissions": sorted(self.perms)}


# admins.role defaults to 'admin' in the existing schema. Unknown roles are read-only.
ROLE_PERMS = {
    "viewer": {"read"},
    "moderator": {"read", "review", "edit"},
    "admin": {"read", "review", "edit", "delete", "users"},
    "superadmin": {"read", "review", "edit", "delete", "users"},
}
_revoked: dict[str, float] = {}  # jti -> expiry (per process; tokens also expire)


def load_admin(user_id: str) -> Admin | None:
    rows = db().table("admins").select("user_id,email,full_name,role").eq("user_id", user_id).limit(1).execute().data
    if not rows:
        return None
    r = rows[0]
    return Admin(id=r["user_id"], email=r.get("email"), full_name=r.get("full_name"), role=r.get("role") or "admin")


def supabase_password_login(email: str, password: str) -> str | None:
    """Checks the password with Supabase Auth (bcrypt hashes in auth.users).
    Calls GoTrue directly instead of db().auth so the shared client never switches identity."""
    s = settings()
    try:
        r = httpx.post(f"{s.supabase_url}/auth/v1/token", params={"grant_type": "password"},
                       json={"email": email, "password": password},
                       headers={"apikey": s.service_key, "Authorization": f"Bearer {s.service_key}"}, timeout=10)
    except httpx.HTTPError as exc:
        log.error("supabase auth unreachable: %s", exc)
        raise ApiError(502, "auth_unavailable", "The sign-in service is unavailable. Try again shortly.")
    if r.status_code == 200:
        return r.json()["user"]["id"]
    if r.status_code == 429:
        raise ApiError(429, "rate_limited", "Too many sign-in attempts. Wait a few minutes and try again.")
    if r.status_code in (400, 401, 403, 422):
        return None
    log.error("supabase auth error %s: %s", r.status_code, r.text[:300])
    raise ApiError(502, "auth_unavailable", "The sign-in service is unavailable. Try again shortly.")


def issue_admin_token(admin: Admin) -> dict:
    s = settings()
    now = int(time.time())
    exp = now + int(s.session_hours * 3600)
    token = jwt.encode({"sub": admin.id, "role": admin.role, "typ": "morisafe-admin", "iat": now, "exp": exp,
                        "jti": secrets.token_hex(16)}, s.app_secret, algorithm="HS256")
    return {"token": token, "expires_at": exp, "admin": admin.public()}


def _claims(authorization: str | None) -> dict:
    if not authorization or not authorization.lower().startswith("bearer "):
        raise ApiError(401, "not_authenticated", "Sign in as an administrator to continue.")
    try:
        claims = jwt.decode(authorization[7:].strip(), settings().app_secret, algorithms=["HS256"],
                            options={"require": ["exp", "sub", "jti"]})
    except jwt.ExpiredSignatureError:
        raise ApiError(401, "session_expired", "Your session has expired. Sign in again.")
    except jwt.PyJWTError:
        raise ApiError(401, "invalid_token", "Your session is not valid. Sign in again.")
    if claims.get("typ") != "morisafe-admin" or claims["jti"] in _revoked:
        raise ApiError(401, "invalid_token", "Your session is not valid. Sign in again.")
    return claims


def revoke(authorization: str | None) -> None:
    claims = _claims(authorization)
    now = time.time()
    for k in [k for k, v in _revoked.items() if v < now]:
        _revoked.pop(k, None)
    _revoked[claims["jti"]] = claims["exp"]


def current_admin(authorization: str | None = Header(default=None)) -> Admin:
    """Every admin request re-reads public.admins, so removing someone takes effect immediately.
    The admin identity always comes from the verified token, never from the request body."""
    claims = _claims(authorization)
    admin = load_admin(claims["sub"])
    if admin is None:
        raise ApiError(401, "not_admin", "This account no longer has administrator access.")
    return admin


def require(perm: str):
    def dep(admin: Admin = Depends(current_admin)) -> Admin:
        if perm not in admin.perms:
            raise ApiError(403, "forbidden", f"Your role ({admin.role}) cannot do this.")
        return admin
    return dep


# ================================================================ citizen accounts (NID sign-in)
# The National Identity Card number is 14 characters: the surname's first letter, the date of birth
# as DDMMYY, then 7 letters/digits. It is only ever stored as an HMAC (lookup) and a masked copy.
_NID = re.compile(r"^[A-Z]\d{6}[0-9A-Z]{7}$")
NID_HELP = "Enter your 14-character National Identity Card number, for example A0101901234567."
COMMON_PASSWORDS = {"password", "password1", "password123", "12345678", "123456789", "1234567890", "qwerty123",
                    "azerty123", "morisafe", "morisafe1", "mauritius", "mauritius1", "iloveyou1", "abc12345", "admin123"}


def normalise_nid(raw: str | None) -> str:
    return re.sub(r"[\s\-]", "", raw or "").upper()


def validate_nid(raw: str | None) -> str:
    n = normalise_nid(raw)
    if not _NID.fullmatch(n):
        raise ApiError(422, "invalid_nid", NID_HELP, [{"field": "nid", "message": "format"}])
    dd, mm, yy = int(n[1:3]), int(n[3:5]), int(n[5:7])
    ok = False
    for century in (1900, 2000):
        try:
            if date(century + yy, mm, dd) <= date.today():
                ok = True
        except ValueError:
            pass
    if not ok:
        raise ApiError(422, "invalid_nid", "That NID number is not valid: characters 2 to 7 must be a date of birth (DDMMYY).",
                       [{"field": "nid", "message": "date of birth"}])
    return n


def nid_hash(nid: str) -> str:
    return hmac.new(settings().app_secret.encode(), b"nid:" + nid.encode(), hashlib.sha256).hexdigest()


def nid_masked(nid: str) -> str:
    return nid[0] + "*" * 9 + nid[-4:]


def check_password(password: str, nid: str) -> None:
    def bad(msg):
        raise ApiError(422, "weak_password", msg, [{"field": "password", "message": msg}])
    if len(password) < 8:
        bad("Use at least 8 characters for your password.")
    if len(password) > 128:
        bad("Use 128 characters or fewer for your password.")
    if not re.search(r"[A-Za-z]", password) or not re.search(r"\d", password):
        bad("Use at least one letter and one number in your password.")
    if password.lower() in COMMON_PASSWORDS or len(set(password)) < 4:
        bad("That password is too easy to guess. Choose another one.")
    if nid.lower() in password.lower() or nid[1:7] in password:
        bad("Your password must not contain your NID number or date of birth.")


# Salted scrypt (memory-hard, from the standard library). Stored as scrypt$N$r$p$salt$hash: the
# password itself is never stored or logged.
_SCRYPT = (2 ** 15, 8, 1)
_SCRYPT_MEM = 128 * 1024 * 1024


def hash_password(password: str) -> str:
    n, r, p = _SCRYPT
    salt = secrets.token_bytes(16)
    h = hashlib.scrypt(password.encode(), salt=salt, n=n, r=r, p=p, maxmem=_SCRYPT_MEM, dklen=32)
    return f"scrypt${n}${r}${p}${base64.b64encode(salt).decode()}${base64.b64encode(h).decode()}"


def verify_password(password: str, stored: str | None) -> bool:
    try:
        _, n, r, p, salt, h = (stored or "").split("$")
        got = hashlib.scrypt(password.encode(), salt=base64.b64decode(salt), n=int(n), r=int(r), p=int(p),
                             maxmem=_SCRYPT_MEM, dklen=32)
        return hmac.compare_digest(got, base64.b64decode(h))
    except (ValueError, TypeError):
        return False


_DUMMY_HASH: list[str] = []


def burn_password_time(password: str) -> None:
    """Same work as a real check, so the response time does not reveal whether an NID is registered."""
    if not _DUMMY_HASH:
        _DUMMY_HASH.append(hash_password("not-a-real-password-1"))
    verify_password(password, _DUMMY_HASH[0])


@dataclass(frozen=True)
class User:
    id: str
    full_name: str
    role: str
    nid_masked: str
    phone: str | None = None

    def public(self) -> dict:
        return {"id": self.id, "full_name": self.full_name, "role": self.role, "nid_masked": self.nid_masked,
                "phone": self.phone}


USER_COLS = "id,full_name,role,nid_masked,phone,disabled"
USER_TOKEN_DAYS = 30


def user_from_row(r: dict) -> User:
    return User(id=r["id"], full_name=r["full_name"], role=r.get("role") or "citizen", nid_masked=r["nid_masked"],
                phone=r.get("phone"))


def issue_user_token(user: User) -> dict:
    now = int(time.time())
    exp = now + USER_TOKEN_DAYS * 86400
    token = jwt.encode({"sub": user.id, "typ": "morisafe-user", "iat": now, "exp": exp, "jti": secrets.token_hex(12)},
                       settings().app_secret, algorithm="HS256")
    return {"token": token, "expires_at": exp, "user": user.public()}


def optional_user(authorization: str | None = Header(default=None)) -> User | None:
    """The signed-in citizen, or None. A token that is present but invalid is an error, not "anonymous"."""
    if not authorization:
        return None
    if not authorization.lower().startswith("bearer "):
        raise ApiError(401, "invalid_token", "Your sign-in is not valid. Sign in again.")
    try:
        claims = jwt.decode(authorization[7:].strip(), settings().app_secret, algorithms=["HS256"],
                            options={"require": ["exp", "sub"]})
    except jwt.ExpiredSignatureError:
        raise ApiError(401, "session_expired", "Your sign-in has expired. Sign in again.")
    except jwt.PyJWTError:
        raise ApiError(401, "invalid_token", "Your sign-in is not valid. Sign in again.")
    if claims.get("typ") != "morisafe-user":
        raise ApiError(401, "invalid_token", "Your sign-in is not valid. Sign in again.")
    rows = db().table("users").select(USER_COLS).eq("id", claims["sub"]).limit(1).execute().data
    if not rows:
        raise ApiError(401, "invalid_token", "This account no longer exists. Create a new account.")
    if rows[0].get("disabled"):
        raise ApiError(403, "account_disabled", "This account has been disabled. Contact MoriSafe support.")
    return user_from_row(rows[0])


def current_user(user: User | None = Depends(optional_user)) -> User:
    if user is None:
        raise ApiError(401, "sign_in_required", "Sign in with your NID to continue.")
    return user


# ================================================================ human verification (anti-spam)
# Proof of work: the server hands out a signed, single-use challenge and the app must find a nonce whose
# SHA-256 starts with N zero bits. About a second for one person; very expensive for a bot sending thousands.
POW_BITS = {"register": 16, "report": 15, "login": 12}
POW_TTL = 600
_pow_used: dict[str, float] = {}
_pow_lock = threading.Lock()


def _pow_sig(payload: str) -> str:
    return hmac.new(settings().app_secret.encode(), b"pow:" + payload.encode(), hashlib.sha256).hexdigest()[:32]


def issue_challenge(purpose: str) -> dict:
    bits = POW_BITS[purpose]
    exp = int(time.time()) + POW_TTL
    payload = f"{purpose}.{bits}.{exp}.{secrets.token_hex(12)}"
    return {"challenge": f"{payload}.{_pow_sig(payload)}", "bits": bits, "expires_at": exp,
            "enabled": settings().human_check}


def zero_bits(digest: bytes) -> int:
    n = 0
    for byte in digest:
        if byte == 0:
            n += 8
            continue
        return n + 8 - byte.bit_length()
    return n


def verify_human(proof: str | None, purpose: str) -> None:
    """proof = "<challenge>:<nonce>", sent in the X-Human-Proof header."""
    if not settings().human_check:
        return
    fail = ApiError(400, "verification_failed", "Human verification failed. Try again.")
    if not proof or ":" not in proof or len(proof) > 300:
        raise ApiError(400, "verification_required", "Human verification is required. Update the app and try again.")
    challenge, nonce = proof.rsplit(":", 1)
    parts = challenge.split(".")
    if len(parts) != 5 or not nonce.isdigit() or len(nonce) > 20:
        raise fail
    p, bits, exp, _rand, sig = parts
    if p != purpose or not bits.isdigit() or not exp.isdigit() or not hmac.compare_digest(sig, _pow_sig(".".join(parts[:4]))):
        raise fail
    now = time.time()
    if int(exp) < now:
        raise ApiError(400, "verification_expired", "Human verification expired. Try again.")
    if zero_bits(hashlib.sha256(f"{challenge}:{nonce}".encode()).digest()) < int(bits):
        raise fail
    with _pow_lock:
        for k in [k for k, v in _pow_used.items() if v < now]:
            _pow_used.pop(k, None)
        if challenge in _pow_used:
            raise ApiError(400, "verification_reused", "Human verification was already used. Try again.")
        _pow_used[challenge] = float(exp)

"""FastAPI application: error format, CORS, security headers, request size guard, logging."""
from __future__ import annotations

import logging
import os
import time
from pathlib import Path

from dotenv import load_dotenv
from fastapi import FastAPI, Request
from fastapi.exceptions import RequestValidationError
from fastapi.middleware.cors import CORSMiddleware
from fastapi.middleware.gzip import GZipMiddleware
from fastapi.responses import FileResponse, JSONResponse
from starlette.exceptions import HTTPException as StarletteHTTPException

load_dotenv()

from .core import ApiError, log, settings  # noqa: E402
from .routes import router  # noqa: E402

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s: %(message)s")
MAX_BODY = 12 * 1024 * 1024
# strict-origin-when-cross-origin: other sites (map tiles, address lookup) see only "morisafe's address", never the
# page path. "no-referrer" made map and geocoding services refuse the requests.
SECURITY_HEADERS = {"X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin",
                    "X-Frame-Options": "DENY", "Cache-Control": "no-store"}


def error_response(status: int, code: str, message: str, details=None, headers=None) -> JSONResponse:
    return JSONResponse({"error": {"code": code, "message": message, "details": details}}, status_code=status, headers=headers)


def create_app() -> FastAPI:
    s = settings()  # fails fast with a clear message if the environment is incomplete
    app = FastAPI(title="MoriSafe API", version="1.0.0",
                  description="Hazard reporting for Mauritius. Public routes need no account; /api/admin/* need an admin session.")

    @app.exception_handler(ApiError)
    async def _api_error(_: Request, exc: ApiError):
        return error_response(exc.status, exc.code, exc.message, exc.details, exc.headers)

    @app.exception_handler(RequestValidationError)
    async def _validation(_: Request, exc: RequestValidationError):
        details = [{"field": ".".join(str(p) for p in e["loc"][1:]) or str(e["loc"][0]), "message": e["msg"]} for e in exc.errors()]
        return error_response(422, "validation_error", "Some fields are missing or invalid.", details)

    @app.exception_handler(StarletteHTTPException)
    async def _http(_: Request, exc: StarletteHTTPException):
        code = {404: "not_found", 405: "method_not_allowed"}.get(exc.status_code, f"http_{exc.status_code}")
        return error_response(exc.status_code, code, str(exc.detail))

    @app.middleware("http")
    async def guard(request: Request, call_next):
        started = time.perf_counter()
        length = request.headers.get("content-length")
        if length and length.isdigit() and int(length) > MAX_BODY:
            response = error_response(413, "request_too_large", "The upload is too large.")
        else:
            try:
                response = await call_next(request)
            except Exception:  # never leak internals; details go to the server log only
                log.exception("unhandled error on %s %s", request.method, request.url.path)
                response = error_response(500, "internal_error", "Something went wrong on the server. Try again.")
        for k, v in SECURITY_HEADERS.items():
            response.headers.setdefault(k, v)
        log.info("%s %s -> %s (%.0f ms)", request.method, request.url.path, response.status_code,
                 (time.perf_counter() - started) * 1000)
        return response

    # Added last, so it wraps everything (errors included get CORS headers). Bearer tokens, no cookies.
    app.add_middleware(CORSMiddleware, allow_origins=list(s.allowed_origins), allow_credentials=False,
                       allow_methods=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
                       allow_headers=["Authorization", "Content-Type", "X-Device-Id", "X-Human-Proof"], max_age=600)

    app.add_middleware(GZipMiddleware, minimum_size=1000)

    status = {"message": "Mauritius Safety Alert Server is running!", "status": "online", "docs": "/docs"}

    @app.get("/api")
    def api_home():
        return status

    app.include_router(router)

    # In the deployed image the built public app and admin dashboard live next to the server, so one
    # address serves all three (no cross-site setup). Locally, without builds, "/" stays the status JSON.
    site = Path(os.getenv("SITE_DIR", Path(__file__).resolve().parent.parent / "site"))
    app_dir, admin_dir = site / "app", site / "admin"

    def send(base: Path, rel: str):
        f = (base / rel).resolve()
        if rel and f.is_file() and f.is_relative_to(base.resolve()):
            # Vite puts a content hash in every file name under assets/, so they can be cached for a year.
            cache = "public, max-age=31536000, immutable" if rel.startswith("assets/") else "public, max-age=3600"
            return FileResponse(f, headers={"Cache-Control": cache})
        if rel.startswith("assets/") or rel.startswith("api/"):
            raise StarletteHTTPException(404, "Not found")
        return FileResponse(base / "index.html", headers={"Cache-Control": "no-cache"})  # single-page app routes

    if (admin_dir / "index.html").is_file():
        @app.get("/admin", include_in_schema=False)
        @app.get("/admin/{rel:path}", include_in_schema=False)
        def admin_site(rel: str = ""):
            return send(admin_dir, rel)

    if (app_dir / "index.html").is_file():
        @app.get("/{rel:path}", include_in_schema=False)
        def public_site(rel: str = ""):
            return send(app_dir, rel)
    else:
        @app.get("/")
        def home():
            return status

    return app


app = create_app()

"""Push notifications for newly approved reports, via Firebase Cloud Messaging (HTTP v1).

Inactive until FIREBASE_SERVICE_ACCOUNT is set (path to, or JSON of, a Firebase service account key).
Without it the mobile app still shows in-app notifications while it is running."""
from __future__ import annotations

import json
import os

import httpx

from .core import db, log, settings
from .rules import NEAR_KM, distance_km, label

NEARBY_MARGIN_KM = 1.6  # device locations are rounded to 0.01 degrees (~1.1 km)


def select_targets(devices: list[dict], report: dict) -> list[dict]:
    """Devices that asked for this incident type (no choice saved = every type), minus
    "only within 10 km" devices that are further away."""
    out = []
    for d in devices:
        cats = d.get("notify_categories")
        if not d.get("push_token") or (cats is not None and report["category"] not in cats):
            continue
        if d.get("only_nearby"):
            if d.get("approx_lat") is None or d.get("approx_lng") is None:
                continue
            km = distance_km(float(d["approx_lat"]), float(d["approx_lng"]), float(report["latitude"]), float(report["longitude"]))
            if km > NEAR_KM + NEARBY_MARGIN_KM:
                continue
        out.append(d)
    return out


def _credentials():
    from google.oauth2 import service_account  # imported lazily: only needed when push is configured
    raw = settings().firebase_credentials
    info = json.loads(raw) if raw.strip().startswith("{") else json.load(open(os.path.expanduser(raw)))
    creds = service_account.Credentials.from_service_account_info(info, scopes=["https://www.googleapis.com/auth/firebase.messaging"])
    return creds, info["project_id"]


def notify_approved(report: dict) -> int:
    """Runs as a background task after approval. Returns the number of messages accepted by FCM."""
    if not settings().firebase_credentials:
        log.info("push not configured; skipped notification for report %s", report["id"])
        return 0
    try:
        import google.auth.transport.requests
        creds, project = _credentials()
        creds.refresh(google.auth.transport.requests.Request())
        devices = (db().table("devices").select("device_hash,push_token,notify_categories,"
                   "only_nearby,approx_lat,approx_lng").not_.is_("push_token", "null").limit(10000).execute().data)
        targets = select_targets(devices, report)
        title = f"{label(report)} reported"
        body = report.get("location_name") or "Mauritius"
        sent = 0
        with httpx.Client(timeout=10) as http:
            for d in targets:
                r = http.post(f"https://fcm.googleapis.com/v1/projects/{project}/messages:send",
                              headers={"Authorization": f"Bearer {creds.token}"},
                              json={"message": {"token": d["push_token"], "notification": {"title": title, "body": body},
                                                "data": {"report_id": report["id"]}, "android": {"priority": "high"}}})
                if r.status_code == 200:
                    sent += 1
                elif r.status_code in (400, 404) and ("UNREGISTERED" in r.text or "INVALID_ARGUMENT" in r.text):
                    db().table("devices").update({"push_token": None}).eq("device_hash", d["device_hash"]).execute()
                else:
                    log.warning("FCM %s: %s", r.status_code, r.text[:200])
        log.info("push for report %s: %d/%d sent", report["id"], sent, len(targets))
        return sent
    except Exception:
        log.exception("push notification failed for report %s", report.get("id"))
        return 0

