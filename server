ADMIN_ROLES = ("viewer", "moderator", "admin", "superadmin")


def _gotrue(method: str, path: str, **kw):
    """Supabase Auth admin API with the service key (never changes the shared client's session)."""
    import httpx
    s = settings()
    try:
        return httpx.request(method, f"{s.supabase_url}/auth/v1{path}", timeout=15,
                             headers={"apikey": s.service_key, "Authorization": f"Bearer {s.service_key}"}, **kw)
    except httpx.HTTPError as exc:
        log.error("supabase auth admin unreachable: %s", exc)
        raise ApiError(502, "auth_unavailable", "The sign-in service is unavailable. Try again shortly.")


def _auth_users() -> dict[str, dict]:
    r = _gotrue("GET", "/admin/users", params={"page": 1, "per_page": 1000})
    if r.status_code != 200:
        return {}
    return {u["id"]: u for u in r.json().get("users", [])}


