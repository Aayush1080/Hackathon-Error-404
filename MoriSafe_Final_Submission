@router.get("/reports")
def list_public(response: Response, category: str | None = None, town: str | None = None,
                source: Literal["citizen", "police"] | None = None, lang: str | None = None,
                near_lat: float | None = None, near_lng: float | None = None, radius_km: float = Query(10, gt=0, le=60)):
    """Approved reports published in the last 20 hours (one per incident: merged duplicates are hidden)."""
    if category and category not in CATEGORIES:
        raise ApiError(422, "validation_error", "Unknown incident type.")
    now = now_utc()
    rows = _public_rows(category)
    urls = signed_urls(photo_paths(rows), PUBLIC_URL_TTL)
    items = [public_item(r, now, urls) for r in rows]
    if town:
        items = [i for i in items if i["town"] == town]
    if source:
        items = [i for i in items if i["source"] == source]
    if near_lat is not None and near_lng is not None:
        _validate_point(near_lat, near_lng)
        items = [i for i in items if distance_km(near_lat, near_lng, i["latitude"], i["longitude"]) <= radius_km]
    _translate_items(items, lang)
    response.headers["Cache-Control"] = "no-store"
    return {"server_time": now.isoformat(), "rules": {"current_hours": CURRENT_HOURS, "older_hours": 12},
            "reports": items}


@router.get("/reports/mine")
def my_reports(x_device_id: str | None = Header(default=None), user: User | None = Depends(optional_user)):
    """Status of the reports this account (or, signed out, this device) sent in the last 30 days."""
    h = device_hash(x_device_id)
    if not user and not h:
        raise ApiError(400, "device_id_required", "X-Device-Id header with a UUID is required.")
    since = (now_utc() - timedelta(days=30)).isoformat()
    q = db().table("reports").select("id,category,custom_category,location_name,status,created_at,duplicate_of")
    q = q.eq("user_id", user.id) if user else q.eq("reporter_hash", h)
    rows = q.gte("created_at", since).order("created_at", desc=True).limit(20).execute().data
    shown = {"pending": "pending", "approved": "approved", "rejected": "not published",
             "resolved": "resolved", "archived": "not published"}
    return {"reports": [{"id": r["id"], "label": label(r), "category": r["category"], "location_name": r["location_name"],
                         "status": shown[r["status"]], "merged": bool(r.get("duplicate_of")),
                         "created_at": r["created_at"]} for r in rows]}


@router.get("/reports/{report_id}")
def get_public(report_id: uuid.UUID, lang: str | None = None):
    now = now_utc()
    rows = _public_rows(report_id=str(report_id))
    if not rows:
        raise ApiError(404, "not_found", "This incident is not available.")
    item = public_item(rows[0], now, signed_urls(photo_paths(rows), PUBLIC_URL_TTL))
    _translate_items([item], lang)
    return {"report": item}


def _duplicate_candidates(category: str, custom: str | None, lat: float, lng: float) -> list[dict]:
    """Open incidents (pending or published) of the same type within 500 m, published first, nearest first."""
    now = now_utc()
    since = now - timedelta(hours=CURRENT_HOURS)
    rows = (db().table("reports").select("id,status,category,custom_category,location_name,latitude,longitude,created_at,approved_at")
            .in_("status", ["pending", "approved"]).is_("duplicate_of", "null").eq("category", category)
            .gte("created_at", (now - timedelta(days=7)).isoformat()).limit(500).execute().data)
    out = []
    for r in rows:
        fresh = parse_ts(r["approved_at"]) >= since if r["status"] == "approved" and r.get("approved_at") else parse_ts(r["created_at"]) >= since
        if not fresh:
            continue
        if category == "Other" and (r.get("custom_category") or "").strip().lower() != (custom or "").strip().lower():
            continue
        km = distance_km(lat, lng, float(r["latitude"]), float(r["longitude"]))
        if km <= DUPLICATE_KM:
            out.append({**r, "km": km})
    return sorted(out, key=lambda r: (r["status"] != "approved", r["km"]))


@router.post("/reports", status_code=201)
def submit_report(
    request: Request,
    response: Response,
    category: str = Form(...),
    custom_category: str | None = Form(None),
    description: str | None = Form(None),
    location_name: str = Form(...),
    town: str | None = Form(None),
    latitude: float = Form(...),
    longitude: float = Form(...),
    observed_time: str = Form(...),
    client_ref: uuid.UUID | None = Form(None),
    confirm_distinct: bool = Form(False),
    merge_into: uuid.UUID | None = Form(None),
    my_latitude: float | None = Form(None),
    my_longitude: float | None = Form(None),
    photo: UploadFile = File(...),
    x_device_id: str | None = Header(default=None),
    x_human_proof: str | None = Header(default=None),
    user: User = Depends(current_user),
):
    """Saves a report as PENDING. It becomes public only after an administrator approves it. A report of an
    incident that is already open nearby is merged into it, so reviewers see one incident with every photo."""
    dev = device_hash(x_device_id)
    limiter.hit(f"submit:ip:{client_ip(request)}", 30, 3600)
    limiter.hit(f"submit:user:{user.id}", 6, 600)
    limiter.hit(f"submit:user-day:{user.id}", 30, 86400)

    category, custom = _validate_category(category, custom_category)
    _validate_point(latitude, longitude)
    # The incident must be within 500 m of where the reporter is when sending.
    if my_latitude is None or my_longitude is None or not in_mauritius(my_latitude, my_longitude):
        raise ApiError(422, "location_required", "Your current location in Mauritius is needed to send a report.",
                       [{"field": "my_latitude/my_longitude", "message": "required"}])
    if distance_km(my_latitude, my_longitude, latitude, longitude) > REPORT_RADIUS_KM:
        raise ApiError(422, "too_far", "The incident location must be within 500 m of where you are now.",
                       [{"field": "latitude/longitude", "message": "more than 500 m from your location"}])
    location = clean_text(location_name, "Location", 160, required=True)
    desc = clean_text(description, "Description", 500, multiline=True)
    observed_at = observed_at_from_hhmm(observed_time)
    town = town if town in TOWNS else match_town(location)

    if client_ref:  # the app resends the same client_ref when retrying after a network error
        existing = db().table("reports").select("id,status,created_at,category,custom_category,user_id,duplicate_of") \
            .eq("client_ref", str(client_ref)).limit(1).execute().data
        if existing and existing[0].get("user_id") == user.id:
            response.status_code = 200
            e = existing[0]
            return {"report": {"id": e["id"], "status": e["status"], "label": label(e), "created_at": e["created_at"],
                               "merged": bool(e.get("duplicate_of"))}, "already_received": True}
        if existing:
            raise ApiError(409, "client_ref_in_use", "This submission reference was already used.")

    verify_human(x_human_proof, "report")

    duplicate_of = None
    if not confirm_distinct:
        cands = _duplicate_candidates(category, custom, latitude, longitude)
        target = next((c for c in cands if merge_into and c["id"] == str(merge_into)), None)
        if target:
            duplicate_of = target["id"]
        elif cands and cands[0]["status"] == "approved" and not merge_into:
            c = cands[0]
            raise ApiError(409, "possible_duplicate",
                           f"{label(c)} was already reported {round(c['km'] * 1000)} m away at {c.get('location_name') or 'this location'}.",
                           {"existing": {"id": c["id"], "label": label(c), "location_name": c.get("location_name"),
                                         "distance_m": round(c["km"] * 1000)}})
        elif cands:
            duplicate_of = cands[0]["id"]  # same incident, still being reviewed: merge quietly

    limit = settings().max_upload_bytes
    data = photo.file.read(limit + 1)
    if len(data) > limit:
        raise ApiError(413, "photo_too_large", f"The photo is larger than {limit // (1024 * 1024)} MB.")
    processed = process_photo(data)

    path = store_photo(processed)
    row = {
        "title": f"{custom or category} - {location}"[:200], "category": category, "custom_category": custom,
        "description": desc or "", "latitude": latitude, "longitude": longitude, "location_name": location,
        "town": town, "observed_time": observed_time.strip(), "observed_at": observed_at.isoformat(),
        "status": "pending", "reporter_hash": dev, "user_id": user.id,
        "source": "police" if user.role == "police" else "citizen", "duplicate_of": duplicate_of,
        "client_ref": str(client_ref) if client_ref else None,
    }
    try:
        rep = db().table("reports").insert(row).execute().data[0]
    except Exception:
        remove_photos([path])
        raise
    try:
        db().table("report_photos").insert({"report_id": rep["id"], "storage_path": path, "mime_type": "image/jpeg",
                                            "size_bytes": len(processed.data), "width": processed.width,
                                            "height": processed.height, "sha256": processed.sha256}).execute()
    except Exception:
        db().table("reports").delete().eq("id", rep["id"]).execute()
        remove_photos([path])
        raise
    log.info("report %s submitted (pending%s)", rep["id"], f", merged into {duplicate_of}" if duplicate_of else "")
    return {"report": {"id": rep["id"], "status": "pending", "label": label(rep), "created_at": rep["created_at"],
                       "merged": bool(duplicate_of)}}


class FeedbackIn(BaseModel):
    still_there: bool


@router.post("/reports/{report_id}/feedback")
def report_feedback(report_id: uuid.UUID, body: FeedbackIn, request: Request,
                    x_device_id: str | None = Header(default=None), user: User | None = Depends(optional_user)):
    """"Is it still there?" answer from someone passing near a published incident. One answer per person."""
    h = device_hash(x_device_id)
    voter = f"u:{user.id}" if user else f"d:{h}" if h else None
    if not voter:
        raise ApiError(400, "device_id_required", "X-Device-Id header with a UUID is required.")
    limiter.hit(f"feedback:{voter}", 30, 3600)
    limiter.hit(f"feedback:ip:{client_ip(request)}", 120, 3600)
    if not _public_rows(report_id=str(report_id)):
        raise ApiError(404, "not_found", "This incident is no longer published.")
    db().table("report_feedback").upsert({"report_id": str(report_id), "voter": voter, "still_there": body.still_there,
                                          "created_at": now_utc().isoformat()}, on_conflict="report_id,voter").execute()
    return {"recorded": True}


