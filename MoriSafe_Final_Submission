    db().table("reports").update({"duplicate_of": target["id"]}).eq("duplicate_of", row["id"]).execute()
    db().table("reports").update({"duplicate_of": target["id"]}).eq("id", row["id"]).execute()
    _audit(admin, row["id"], "merge", row["status"], row["status"], {"into": target["id"]})
