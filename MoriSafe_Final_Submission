"""Machine translation of report text (descriptions and "Other" incident names) for the public app.

Provider: Google Cloud Translation if GOOGLE_TRANSLATE_API_KEY is set, otherwise the free MyMemory API.
Results are cached in public.translations (and in memory), so each text is translated once per language.
Only approved, public report text is ever sent for translation. Kreol Morisien falls back to French when
the provider has no Kreol model."""
from __future__ import annotations

import hashlib
import os
import threading
from concurrent.futures import ThreadPoolExecutor, wait

import httpx

from .core import db, log

LANGS = {"en", "fr", "mfe"}
_mem: dict[str, str] = {}
_pending: set[str] = set()
_lock = threading.Lock()
_pool = ThreadPoolExecutor(max_workers=6, thread_name_prefix="translate")
_http = httpx.Client(timeout=8, headers={"User-Agent": "MoriSafe/1.0"})


def _key(lang: str, text: str) -> str:
    return hashlib.sha256(f"{lang}\n{text}".encode()).hexdigest()


def _google(text: str, lang: str) -> str | None:
    key = os.getenv("GOOGLE_TRANSLATE_API_KEY")
    if not key:
        return None
    r = _http.post("https://translation.googleapis.com/language/translate/v2",
                   params={"key": key}, json={"q": text, "target": lang, "format": "text"})
    if r.status_code != 200:
        log.warning("google translate %s: %s", r.status_code, r.text[:200])
        return None
    return r.json()["data"]["translations"][0]["translatedText"]


def _mymemory(text: str, lang: str) -> str | None:
    r = _http.get("https://api.mymemory.translated.net/get", params={"q": text[:500], "langpair": f"Autodetect|{lang}"})
    if r.status_code != 200:
        return None
    d = r.json()
    rd = d.get("responseData") or {}
    out = rd.get("translatedText")
    if str(rd.get("detectedLanguage") or "").lower().startswith(lang) or (out and "SELECT TWO DISTINCT" in out.upper()):
        return text  # already in that language
    if d.get("responseStatus") not in (200, "200") or not out or "MYMEMORY WARNING" in out:
        return None
    return out


def _translate_one(text: str, lang: str) -> str:
    """Never raises: on any failure the original text is returned (and not cached, so it is retried later)."""
    k = _key(lang, text)
    try:
        out = _google(text, lang)
        if out is None and lang == "mfe":
            out = _google(text, "fr")
        if out is None:
            out = _mymemory(text, "fr" if lang == "mfe" else lang)
    except Exception as exc:  # network trouble: show the original for now
        log.warning("translation failed: %s", exc)
        out = None
    finally:
        with _lock:
            _pending.discard(k)
    if not out:
        return text
    with _lock:
        _mem[k] = out
    try:
        db().table("translations").upsert({"key": k, "lang": lang, "text": out}, on_conflict="key").execute()
    except Exception as exc:
        log.warning("translation cache write failed: %s", exc)
    return out


def translate_many(texts: list[str], lang: str, budget_s: float = 4.0) -> dict[str, str]:
    """{original: translated} for every non-empty text. Anything not ready within the budget keeps
    translating in the background and is served from the cache on the next request."""
    texts = [t for t in dict.fromkeys(texts) if t and t.strip()]
    if lang not in LANGS or not texts:
        return {}
    out: dict[str, str] = {}
    missing: dict[str, str] = {}
    for t in texts:
        k = _key(lang, t)
        if k in _mem:
            out[t] = _mem[k]
        else:
            missing[k] = t
    if missing:
        try:
            rows = db().table("translations").select("key,text").in_("key", list(missing)).execute().data
        except Exception:
            rows = []
        for r in rows:
            _mem[r["key"]] = r["text"]
            out[missing.pop(r["key"])] = r["text"]
    futures = {}
    for k, t in missing.items():
        with _lock:
            if k in _pending:
                continue
            _pending.add(k)
        futures[_pool.submit(_translate_one, t, lang)] = t
    if futures:
        done, _ = wait(futures, timeout=budget_s)
        for f in done:
            out[futures[f]] = f.result()
    return out


