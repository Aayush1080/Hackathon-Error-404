class RegisterIn(BaseModel):
    nid: str = Field(..., max_length=32)
    full_name: str = Field(..., max_length=120)
    phone: str | None = Field(None, max_length=32)
    password: str = Field(..., max_length=200)


@router.post("/auth/register", status_code=201)
def register(body: RegisterIn, request: Request, x_human_proof: str | None = Header(default=None)):
    limiter.hit(f"register:ip:{client_ip(request)}", 10, 3600)
    nid = validate_nid(body.nid)
    name = clean_text(body.full_name, "Full name", 80, required=True)
    if len(name) < 2 or not any(ch.isalpha() for ch in name):
        raise ApiError(422, "validation_error", "Enter your full name.", [{"field": "full_name", "message": "required"}])
    phone = None
    if body.phone and body.phone.strip():
        digits = "".join(ch for ch in body.phone if ch.isdigit())
        digits = digits[3:] if digits.startswith("230") and len(digits) > 8 else digits
        if not 7 <= len(digits) <= 8:
            raise ApiError(422, "validation_error", "Enter a 7 or 8 digit Mauritius phone number.", [{"field": "phone", "message": "format"}])
        phone = "+230 " + digits
    check_password(body.password, nid)
    verify_human(x_human_proof, "register")
    h = nid_hash(nid)
    taken = ApiError(409, "nid_registered", "An account with this NID already exists. Sign in instead.")
    if db().table("users").select("id").eq("nid_hash", h).limit(1).execute().data:
        raise taken
    try:
        row = db().table("users").insert({"nid_hash": h, "nid_masked": nid_masked(nid), "full_name": name, "phone": phone,
                                          "password_hash": hash_password(body.password),
                                          "last_login_at": now_utc().isoformat()}).execute().data[0]
    except Exception as exc:
        if "duplicate" in str(exc).lower() or "23505" in str(exc):
            raise taken
        raise
    log.info("citizen account %s created", row["id"])
    return issue_user_token(user_from_row(row))


class LoginNidIn(BaseModel):
    nid: str = Field(..., max_length=32)
    password: str = Field(..., min_length=1, max_length=200)


@router.post("/auth/login")
def citizen_login(body: LoginNidIn, request: Request, x_human_proof: str | None = Header(default=None)):
    limiter.hit(f"ulogin:ip:{client_ip(request)}", 30, 900)
    nid = validate_nid(body.nid)
    h = nid_hash(nid)
    limiter.hit(f"ulogin:nid:{h}", 10, 900)
    verify_human(x_human_proof, "login")
    wrong = ApiError(401, "invalid_credentials", "NID number or password is incorrect.")
    rows = db().table("users").select(f"{USER_COLS},password_hash,failed_logins,locked_until").eq("nid_hash", h).limit(1).execute().data
    if not rows:
        burn_password_time(body.password)
        raise wrong
    u = rows[0]
    now = now_utc()
    if u.get("locked_until") and parse_ts(u["locked_until"]) > now:
        mins = max(1, round((parse_ts(u["locked_until"]) - now).total_seconds() / 60))
        raise ApiError(429, "account_locked", f"Too many wrong passwords. Try again in {mins} minute{'s' if mins > 1 else ''}.")
    if not verify_password(body.password, u["password_hash"]):
        fails = (u.get("failed_logins") or 0) + 1
        patch = {"failed_logins": fails}
        if fails >= LOCKOUT_AFTER:
            patch = {"failed_logins": 0, "locked_until": (now + timedelta(minutes=LOCKOUT_MIN)).isoformat()}
        db().table("users").update(patch).eq("id", u["id"]).execute()
        raise wrong
    if u.get("disabled"):
        raise ApiError(403, "account_disabled", "This account has been disabled. Contact MoriSafe support.")
    db().table("users").update({"failed_logins": 0, "locked_until": None, "last_login_at": now.isoformat()}).eq("id", u["id"]).execute()
    return issue_user_token(user_from_row(u))


