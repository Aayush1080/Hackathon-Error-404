def jpeg(size=(800, 600), color=(30, 120, 200), exif=True) -> bytes:
    img, out = Image.new("RGB", size, color), io.BytesIO()
    if exif:
        ex = Image.Exif()
        ex[0x010F] = "TestCam"   # camera make
        ex[0x0112] = 6           # orientation: rotate 90 degrees
        img.save(out, "JPEG", exif=ex.tobytes())
    else:
        img.save(out, "JPEG")
    return out.getvalue()


def submit(client, lat, lng, cat="Flooding", photo=None, device=None, name="p.jpg", ctype="image/jpeg", **extra):
    data = {"category": cat, "location_name": "Royal Road, Port Louis", "latitude": str(lat), "longitude": str(lng),
            "observed_time": "08:30", **{k: str(v) for k, v in extra.items()}}
    files = {"photo": (name, jpeg() if photo is None else photo, ctype)}
    return client.post("/api/reports", data=data, files=files, headers={"X-Device-Id": device or str(uuid.uuid4())})


def login(client, creds=ADMIN):
    r = client.post("/api/admin/login", json={"email": creds[0], "password": creds[1]})
    assert r.status_code == 200, r.text
    return {"Authorization": "Bearer " + r.json()["token"]}


def set_status(client, auth, rid, status, reason=None):
    return client.patch(f"/api/admin/reports/{rid}/status", json={"status": status, "reason": reason}, headers=auth)


def public(client):
    r = client.get("/api/reports")
    assert r.status_code == 200
    return {x["id"]: x for x in r.json()["reports"]}


# ---------------------------------------------------------------- migration
def test_migration_backfilled_existing_rows_and_locked_down_direct_access(client):
    rows = {r[0]: r[1:] for r in sql("select id::text, category, custom_category, severity, approved_at is not null, "
                                       "observed_at, status from public.reports where id::text like 'aaaaaaaa%'")}
    assert rows["aaaaaaaa-0000-4000-8000-000000000001"][:4] == ("Other", "Fallen tree on road", "info", True)
    flood = rows["aaaaaaaa-0000-4000-8000-000000000002"]
    assert flood[2] == "warning"
    # sent 00:30 Mauritius time on the 14th with "23:59" -> 23:59 on the 13th = 19:59 UTC
    from datetime import datetime, timezone
    assert flood[4] == datetime(2026, 11, 13, 19, 59, tzinfo=timezone.utc)
    assert rows["aaaaaaaa-0000-4000-8000-000000000003"][2:5:2] == ("urgent", None)
    assert sql("select storage_path from report_photos where report_id = 'aaaaaaaa-0000-4000-8000-000000000001'") == [("legacy-1.jpg",)]
    assert sql("select public, allowed_mime_types from storage.buckets where id = 'report-photos'")[0] == (False, ["image/jpeg"])
    policies = {r[0] for r in sql("select policyname from pg_policies where tablename in ('reports', 'objects')")}
    assert not policies & {"public submits", "public reads approved", "anyone uploads report photos", "public reads report photos"}
    assert {"admins read all", "admins update", "admins delete"} <= policies

    # The prototype's public photo URL and its anon-key reads/writes no longer work.
    assert httpx.get(f"{URL}/storage/v1/object/public/report-photos/legacy-1.jpg").status_code == 400
    anon = {"apikey": os.environ["DEVSTACK_ANON_KEY"], "Authorization": "Bearer " + os.environ["DEVSTACK_ANON_KEY"]}
    assert httpx.get(f"{URL}/rest/v1/reports?select=id", headers=anon).json() == []
    ins = httpx.post(f"{URL}/rest/v1/reports", headers=anon, json={"title": "x", "category": "Fire", "latitude": -20.2,
                                                                   "longitude": 57.5, "status": "pending"})
    assert ins.status_code in (401, 403)

    # The legacy approved report is public through the API, with its photo via a signed URL.
    legacy = public(client)["aaaaaaaa-0000-4000-8000-000000000001"]
    assert legacy["label"] == "Fallen tree on road" and legacy["older"] is False
    assert httpx.get(legacy["photo_url"]).headers["content-type"] == "image/jpeg"


# ---------------------------------------------------------------- brief tests 1-6
def test_1_submitted_report_is_saved_pending_with_its_photo_and_not_public(client):
    lat, lng = spot()
