@router.post("/admin/admins", status_code=201)
def admin_add(body: AdminCreateIn, admin: Admin = Depends(require("users"))):
    """Gives someone dashboard access. A new email gets a Supabase sign-in with the password given here;
    an existing Supabase user keeps their current password."""
    import re as _re
    email = body.email.strip().lower()
    if not _re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email):
        raise ApiError(422, "validation_error", "Enter a valid email address.", [{"field": "email", "message": "format"}])
    if body.role == "superadmin" and admin.role != "superadmin":
        raise ApiError(403, "forbidden", "Only a superadmin can add another superadmin.")
    name = clean_text(body.full_name, "Full name", 80) if body.full_name else None
    existing = next((u for u in _auth_users().values() if (u.get("email") or "").lower() == email), None)
    if existing:
        uid = existing["id"]
    else:
        pw = body.password or ""
        if len(pw) < 10 or not _re.search(r"[A-Za-z]", pw) or not _re.search(r"\d", pw):
            raise ApiError(422, "weak_password", "Give the new administrator a password of at least 10 characters with letters and a number.",
                           [{"field": "password", "message": "weak"}])
        r = _gotrue("POST", "/admin/users", json={"email": email, "password": pw, "email_confirm": True,
                                                 "user_metadata": {"full_name": name} if name else {}})
        if r.status_code not in (200, 201):
            log.warning("create auth user failed %s: %s", r.status_code, r.text[:200])
            raise ApiError(422, "auth_create_failed", "Supabase could not create this sign-in. Check the email and password.")
        uid = r.json()["id"]
    if db().table("admins").select("user_id").eq("user_id", uid).limit(1).execute().data:
        raise ApiError(409, "already_admin", "This person is already an administrator.")
    db().table("admins").insert({"user_id": uid, "email": email, "full_name": name, "role": body.role}).execute()
    _audit(admin, None, "admin_add", None, None, {"email": email, "role": body.role, "new_sign_in": not existing})
    return {"admin": {"user_id": uid, "email": email, "full_name": name, "role": body.role}, "new_sign_in": not existing}


