    viewer = login(client, ("viewer@morisafe.test", "Viewer-Pass-123"))
    assert client.get("/api/admin/reports", headers=viewer).status_code == 200
    assert set_status(client, viewer, rid, "approved").status_code == 403
    assert client.delete(f"/api/admin/reports/{rid}", headers=viewer).status_code == 403
    # removing someone from public.admins revokes access immediately
    sql("delete from admins where email = 'viewer@morisafe.test'")
    assert client.get("/api/admin/me", headers=viewer).json()["error"]["code"] == "not_admin"
    sql("insert into admins (user_id, email, full_name, role) values ('33333333-3333-4333-8333-333333333333', 'viewer@morisafe.test', 'Test Viewer', 'viewer')")
    # logout revokes the token
    auth = login(client)
    assert client.post("/api/admin/logout", headers=auth).status_code == 204
    assert client.get("/api/admin/me", headers=auth).status_code == 401

    # invalid uploads: text, a PHP script named .jpg, a GIF, too large
    for payload in [b"just some text pretending to be a photo" * 10, b"<?php system($_GET['c']); ?>" * 10]:
        r = submit(client, *spot(), photo=payload, name="evil.jpg")
        assert (r.status_code, r.json()["error"]["code"]) == (415, "unsupported_photo_type")
    gif = io.BytesIO()
    Image.new("RGB", (20, 20)).save(gif, "GIF")
    assert submit(client, *spot(), photo=gif.getvalue(), name="a.gif", ctype="image/gif").status_code == 415
    assert submit(client, *spot(), photo=os.urandom(11 * 1024 * 1024)).json()["error"]["code"] == "photo_too_large"
    # a real JPEG with a script appended is accepted, but only re-encoded pixels are stored
    rid_poly = submit(client, *spot(), photo=jpeg(exif=False) + b"<?php echo 1; ?>").json()["report"]["id"]
    path = sql("select storage_path from report_photos where report_id = %s", rid_poly)[0][0]
    assert b"<?php" not in (FILES / path).read_bytes()
    # invalid fields
    assert submit(client, -20.0, 56.0).json()["error"]["code"] == "outside_mauritius"
    assert submit(client, "nan", 57.5).status_code == 422
    assert submit(client, *spot(), cat="Other").status_code == 422          # needs a description of the incident
    assert submit(client, *spot(), cat="Volcano").status_code == 422
    assert submit(client, *spot(), observed_time="25:99").status_code == 422
    r = client.post("/api/reports", data={"category": "Fire", "location_name": "x", "latitude": "-20.2",
                                          "longitude": "57.5", "observed_time": "08:00"})
    assert (r.status_code, r.json()["error"]["code"]) == (422, "validation_error")   # photo missing
    # hostile text is stored literally, never executed
    r = submit(client, *spot(), location_name="x'); drop table reports;--", description="<script>alert(1)</script>")
    assert r.status_code == 201 and sql("select count(*) > 0 from reports")[0][0]
    assert sql("select description from reports where id = %s", r.json()["report"]["id"]) == [("<script>alert(1)</script>",)]


