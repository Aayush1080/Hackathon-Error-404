        [("pending", "warning", "08:30", True)]
    path, mime, size, w, h = sql("select storage_path, mime_type, size_bytes, width, height from report_photos where report_id = %s", rid)[0]
    stored = Image.open(FILES / path)
    assert (mime, stored.format, (w, h), stored.size) == ("image/jpeg", "JPEG", (600, 800), (600, 800))  # EXIF rotation applied
    assert len(stored.getexif()) == 0 and size == (FILES / path).stat().st_size  # metadata (incl. GPS) stripped
    assert rid not in public(client)
    assert client.get(f"/api/reports/{rid}").status_code == 404


def test_2_and_3_admin_reviews_photo_and_location_then_approval_publishes(client):
    lat, lng = spot()
    rid = submit(client, lat, lng, cat="Accident").json()["report"]["id"]
    auth = login(client)
    listed = {x["id"]: x for x in client.get("/api/admin/reports", headers=auth).json()["reports"]}
    item = listed[rid]
    assert item["status"] == "pending" and (item["latitude"], item["longitude"]) == (lat, lng)
    photo = httpx.get(item["image_url"])
    assert photo.status_code == 200 and photo.headers["content-type"] == "image/jpeg"

    r = set_status(client, auth, rid, "approved")
    assert r.status_code == 200, r.text
    assert sql("select status, reviewed_by::text, approved_at is not null from reports where id = %s", rid) == [("approved", ADMIN_ID, True)]
    assert sql("select action, old_status, new_status, admin_email from report_audit where report_id = %s", rid) == \
        [("status", "pending", "approved", "admin@morisafe.test")]

    pub = public(client)[rid]
    assert (pub["latitude"], pub["longitude"], pub["severity"], pub["older"]) == (lat, lng, "urgent", False)
    assert httpx.get(pub["photo_url"]).status_code == 200
    assert client.get(f"/api/reports/{rid}").json()["report"]["id"] == rid
    assert "reporter_hash" not in pub and "reviewed_by" not in pub


