class DeviceIn(BaseModel):
    push_token: str | None = Field(None, max_length=4096)
    platform: Literal["android", "ios", "web"] | None = None
    categories: list[str] | None = Field(None, max_length=10)
    only_nearby: bool = False
    latitude: float | None = None
    longitude: float | None = None
    language: str | None = Field(None, max_length=32)


@router.put("/devices")
def register_device(body: DeviceIn, request: Request, x_device_id: str | None = Header(default=None)):
    h = device_hash(x_device_id)
    if not h:
        raise ApiError(400, "device_id_required", "X-Device-Id header with a UUID is required.")
    limiter.hit(f"device:{h}", 30, 3600)
    limiter.hit(f"device:ip:{client_ip(request)}", 120, 3600)
    cats = None if body.categories is None else [c for c in CATEGORIES if c in body.categories]
    near = body.only_nearby and in_mauritius(body.latitude, body.longitude)
    row = {"device_hash": h, "push_token": body.push_token, "platform": body.platform, "notify_categories": cats,
           "only_nearby": body.only_nearby, "approx_lat": round(body.latitude, 2) if near else None,
           "approx_lng": round(body.longitude, 2) if near else None, "language": body.language,
           "updated_at": now_utc().isoformat()}
    if body.push_token:  # a token moves with the phone: drop it from any older registration
        db().table("devices").update({"push_token": None}).eq("push_token", body.push_token).neq("device_hash", h).execute()
    db().table("devices").upsert(row, on_conflict="device_hash").execute()
    return {"registered": True, "push": bool(body.push_token), "push_server_configured": bool(settings().firebase_credentials)}


@router.delete("/devices", status_code=204)
