  .wrap{padding:24px 0}
  .phone{width:420px;height:min(880px,calc(100dvh - 48px));border-radius:40px;box-shadow:0 40px 80px -30px rgba(15,27,45,.45),0 0 0 10px #0b1220}
}
.scr{position:absolute;inset:0;overflow:auto;padding:calc(var(--safe-t) + 16px) 18px calc(var(--safe-b) + 110px);overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
.scr.full{padding:0;overflow:hidden}
.scr.with-actions{padding-bottom:calc(var(--safe-b) + 170px)}

/* ---------- header ---------- */
.hdr{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.logo{width:42px;height:42px;border-radius:13px;background:var(--grad);display:grid;place-items:center;color:#fff;box-shadow:0 8px 18px -8px rgba(37,99,235,.7);flex:none}
.logo.xl{width:72px;height:72px;border-radius:22px;margin:0 auto 12px}
.hdr-t{flex:1;min-width:0}
.hdr h1{font-size:1.4rem;font-weight:800;letter-spacing:-.02em;line-height:1.1}
