/* ---------- frame: full screen on phones, a framed phone on wide screens ---------- */
.wrap{display:flex;justify-content:center}
.phone{position:relative;transform:translateZ(0);width:100%;height:100vh;height:100dvh;overflow:hidden;background:var(--bg)}
