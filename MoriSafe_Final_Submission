/* ---------- emergency card (always right under the title) ---------- */
.sos{position:relative;overflow:hidden;border-radius:22px;padding:14px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);box-shadow:0 14px 26px -14px rgba(220,38,38,.8)}
.sos:after{content:"";position:absolute;right:-36px;top:-36px;width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,.12);pointer-events:none}
.sos b{display:flex;align-items:center;gap:7px;font-size:.95rem;font-weight:800}
