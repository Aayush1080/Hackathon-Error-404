def _remove_group(admin: Admin, row: dict, action: str) -> int:
    """Deletes an incident with every report merged into it: photo objects first (no orphans), then the rows.
    The audit entry stays."""
    kids = _children(row["id"])
    remove_photos(photo_paths([row] + kids), strict=True)
    if kids:
        db().table("reports").delete().in_("id", [k["id"] for k in kids]).execute()
    db().table("reports").delete().eq("id", row["id"]).execute()
    _audit(admin, row["id"], action, row["status"], None,
           {"label": label(row), "location_name": row.get("location_name"), "created_at": row["created_at"],
            "merged_reports": len(kids)})
    return 1 + len(kids)


@router.patch("/admin/reports/{report_id}/status")
def admin_status(report_id: uuid.UUID, body: StatusIn, background: BackgroundTasks, admin: Admin = Depends(require("review"))):
    row = _get_row(report_id)
    if row.get("duplicate_of"):
        raise ApiError(409, "is_duplicate", "This report is merged into another incident. Review that incident, or unmerge this report first.")
    if body.status == "resolved":  # the incident is over: remove it (and its merged reports) completely
        n = _remove_group(admin, row, "resolve")
        return {"report": None, "deleted": True, "removed": n}
    if row["status"] == body.status:
        raise ApiError(409, "unchanged", f"This report is already {body.status}.")
    now = now_utc().isoformat()
    patch = {"status": body.status, "reviewed_by": admin.id, "reviewed_at": now}
    changes = None
    if body.status == "rejected":
        patch["rejection_reason"] = clean_text(body.reason, "Rejection reason", 300, required=True)
        changes = {"reason": patch["rejection_reason"]}
    if body.status == "approved":
        missing = [k for k in CHECKLIST if not (body.checklist or {}).get(k)]
        if missing:
            raise ApiError(422, "checklist_incomplete", "Complete the review checklist before approving.", {"missing": missing})
        _validate_point(row["latitude"], row["longitude"])
        patch.update(approved_at=now, rejection_reason=None)  # publication starts the 20-hour window
        changes = {"checklist": "complete"}
    db().table("reports").update(patch).eq("id", str(report_id)).eq("status", row["status"]).execute()
    fresh = _get_row(report_id)
    if fresh["status"] != body.status:
        raise ApiError(409, "conflict", "Another administrator changed this report at the same time. Reload and try again.")
    db().table("reports").update(patch).eq("duplicate_of", str(report_id)).execute()  # merged reports follow
    _audit(admin, report_id, "status", row["status"], body.status, changes)
    if body.status == "approved":
        background.add_task(push.notify_approved, fresh)
    return {"report": _detail(report_id)}


