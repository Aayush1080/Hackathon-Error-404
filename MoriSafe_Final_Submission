import { useCallback, useEffect, useMemo, useState } from 'react';
import { useOutletContext } from 'react-router-dom';
import { ShieldCheck, UserX, UserCheck } from 'lucide-react';
import { fetchUsers, updateUser } from '../services/adminService';

/* Citizen accounts (NID sign-in). Admins can disable or re-enable an account. The role (citizen or police)
   cannot be changed here. NIDs are only ever shown masked. */
export default function AdminUsers() {
  const { query, can, notify } = useOutletContext();
  const [users, setUsers] = useState(null), [err, setErr] = useState(''), [busy, setBusy] = useState(null), [role, setRole] = useState('all');
  const load = useCallback(async () => {
    try { setUsers(await fetchUsers()); setErr(''); } catch (e) { setErr(e.message); }
  }, []);
  useEffect(() => { load(); }, [load]);
  const rows = useMemo(() => {
    const q = query.trim().toLowerCase();
    return (users || []).filter((u) => (role === 'all' || u.role === role) && (!q || [u.full_name, u.nid_masked, u.phone].some((v) => String(v ?? '').toLowerCase().includes(q))));
  }, [users, query, role]);

  async function change(u, patch, msg) {
    setBusy(u.id);
    try { await updateUser(u.id, patch); notify('ok', msg); await load(); } catch (e) { notify('err', e.message); } finally { setBusy(null); }
  }
  const canEdit = can('users');
  if (err) return <div className="rounded-lg bg-red-50 p-3 text-sm text-red-700" role="alert">{err} <button className="underline" onClick={load}>Retry</button></div>;
  if (!users) return <p className="text-slate-500">Loading accounts…</p>;
  return (
    <div className="rounded-2xl border border-slate-200/70 bg-white shadow-sm">
      <div className="flex flex-wrap items-center gap-2 p-4">
        <h2 className="mr-auto font-bold font-extrabold">Citizen accounts <span className="text-sm font-normal text-slate-400">({rows.length})</span></h2>
        <select className="rounded-lg border bg-white px-2 py-1.5 text-sm" value={role} onChange={(e) => setRole(e.target.value)} aria-label="Role">
          <option value="all">All accounts</option><option value="citizen">Citizens</option><option value="police">Police</option>
        </select>
      </div>
      <p className="px-4 pb-2 text-xs text-slate-500">People sign in to the app with their NID. Passwords are stored as salted scrypt hashes and NIDs as keyed hashes, so neither can be read here.{!canEdit && ' Your role can view accounts but not change them.'}</p>
      <div className="overflow-x-auto">
        <table className="w-full min-w-[760px] text-left text-sm">
          <thead className="bg-slate-50 text-xs uppercase text-slate-500"><tr>{['Name', 'NID', 'Phone', 'Role', 'Reports', 'Joined', 'Last sign-in', ''].map((h) => <th key={h} className="px-4 py-2">{h}</th>)}</tr></thead>
          <tbody>
            {rows.map((u) => (
              <tr key={u.id} className={`border-t ${u.disabled ? 'bg-slate-50 text-slate-400' : ''}`}>
                <td className="px-4 py-2 font-medium">{u.full_name}{u.disabled && <span className="ml-2 rounded bg-slate-200 px-1.5 text-xs text-slate-600">disabled</span>}</td>
                <td className="px-4 py-2 font-mono text-xs">{u.nid_masked}</td>
                <td className="px-4 py-2">{u.phone || '—'}</td>
                <td className="px-4 py-2">{u.role === 'police'
                  ? <span className="inline-flex items-center gap-1 rounded-full bg-blue-900 px-2 py-0.5 text-xs font-semibold text-white"><ShieldCheck size={12} />Police</span>
                  : <span className="text-xs">Citizen</span>}</td>
                <td className="px-4 py-2">{u.reports}</td>
                <td className="px-4 py-2">{new Date(u.created_at).toLocaleDateString()}</td>
                <td className="px-4 py-2">{u.last_login_at ? new Date(u.last_login_at).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' }) : '—'}</td>
                <td className="px-4 py-2">{canEdit && <div className="flex justify-end gap-1">
                  <button disabled={busy === u.id} title={u.disabled ? 'Enable' : 'Disable'} onClick={() => change(u, { disabled: !u.disabled }, u.disabled ? 'Account enabled.' : 'Account disabled. It can no longer sign in or send reports.')}
                    className={`rounded-lg border px-2 py-1 text-xs disabled:opacity-50 ${u.disabled ? '' : 'border-red-200 text-red-700'}`}>{u.disabled ? <UserCheck size={14} /> : <UserX size={14} />}</button>
                </div>}</td>
              </tr>
            ))}
            {!rows.length && <tr><td colSpan={8} className="p-8 text-center text-slate-400">No accounts yet. People create one in the app with their NID.</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  );
}

import { api, session } from '../lib/api';

export const CATEGORIES = ['Falling debris', 'Accident', 'Fire', 'Flooding', 'Other'];
export const TOWNS = ['Port Louis', 'Curepipe', 'Quatre Bornes', 'Vacoas-Phoenix', 'Rose Hill', 'Beau Bassin', 'Mahébourg', 'Flic en Flac',
  'Grand Baie', 'Triolet', 'Goodlands', 'Moka', 'Centre de Flacq', 'Saint Pierre', 'Souillac', 'Other'];
// "resolved" is not listed: resolving an incident deletes it.
export const STATUSES = ['pending', 'approved', 'rejected', 'archived'];
export const SOURCES = { citizen: 'Citizen', police: 'Police' };
// What a reviewer must confirm before publishing. The server checks the same keys (server/app/routes.py CHECKLIST).
export const CHECKLIST = [
  ['photo', 'The photo clearly shows the reported incident'],
  ['location', 'The map location matches the photo and description'],
  ['category', 'The incident type is correct'],
  ['content', 'No personal data, offensive or unrelated content is shown'],
  ['not_duplicate', 'It is not a duplicate of an incident already published'],
  ['current', 'The incident looks current (not old, staged or a joke)'],
];

export async function login(email, password) {
  const d = await api('/api/admin/login', { method: 'POST', body: { email, password }, auth: false });
  session.set(d);
  return d.admin;
}
export async function logout() {
  try { await api('/api/admin/logout', { method: 'POST' }); } catch { /* the session is cleared either way */ }
  session.clear();
}
export const me = () => api('/api/admin/me');
export const fetchAllReports = async () => (await api('/api/admin/reports')).reports;
export const fetchReport = (id) => api(`/api/admin/reports/${id}`);
export const updateReport = (id, patch) => api(`/api/admin/reports/${id}`, { method: 'PATCH', body: patch });
export const setStatus = (id, status, reason, checklist) =>
  api(`/api/admin/reports/${id}/status`, { method: 'PATCH', body: { status, reason: reason || null, checklist: checklist || null } });
export const deleteReport = (id) => api(`/api/admin/reports/${id}`, { method: 'DELETE' });
export const mergeReport = (id, into) => api(`/api/admin/reports/${id}/merge`, { method: 'POST', body: { into } });
export const unmergeReport = (id) => api(`/api/admin/reports/${id}/unmerge`, { method: 'POST' });
export const fetchUsers = async () => (await api('/api/admin/users')).users;
export const updateUser = (id, patch) => api(`/api/admin/users/${id}`, { method: 'PATCH', body: patch });

export const computeStats = (reports) => ({
  total: reports.length,
  ...Object.fromEntries(STATUSES.map((s) => [s, reports.filter((r) => r.status === s).length])),
  pending: reports.filter((r) => r.status === 'pending' || r.pending_duplicates).length,
});
export const countBy = (arr, fn) => arr.reduce((m, x) => { const k = fn(x); m[k] = (m[k] || 0) + 1; return m; }, {});
export const inMauritius = (lat, lng) => Number.isFinite(lat) && Number.isFinite(lng) && lat >= -20.65 && lat <= -19.85 && lng >= 57.18 && lng <= 58.1;
export const distanceKm = (aLat, aLng, bLat, bLng) => {
  const r = Math.PI / 180, h = Math.sin(((bLat - aLat) * r) / 2) ** 2 + Math.cos(aLat * r) * Math.cos(bLat * r) * Math.sin(((bLng - aLng) * r) / 2) ** 2;
  return 6371 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
};
// Esri street tiles: free, no key, and no referrer requirement (OpenStreetMap's own servers block app traffic).
export const TILES = 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}';
export const TILE_OPTS = { maxZoom: 19, attribution: 'Tiles © Esri · Places © OpenStreetMap contributors' };
export const fetchAudit = async (limit = 10) => (await api(`/api/admin/audit?limit=${limit}`)).audit;
export const timeAgo = (d) => {
  const s = Math.max(0, (Date.now() - new Date(d)) / 1000);
  if (s < 60) return 'just now';
  if (s < 3600) return `${Math.round(s / 60)} min ago`;
  if (s < 86400) return `${Math.round(s / 3600)} h ago`;
  return `${Math.round(s / 86400)} d ago`;
};
export const fetchAdmins = () => api('/api/admin/admins');
export const addAdmin = (body) => api('/api/admin/admins', { method: 'POST', body });
export const setAdminRole = (id, role) => api(`/api/admin/admins/${id}`, { method: 'PATCH', body: { role } });
export const removeAdmin = (id) => api(`/api/admin/admins/${id}`, { method: 'DELETE' });

