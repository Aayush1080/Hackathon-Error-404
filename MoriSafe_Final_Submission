input[type=text],input[type=search],input[type=tel],input[type=password],input[type=time],select,textarea{width:100%;min-height:50px;border:1.5px solid var(--line);border-radius:14px;background:var(--card);padding:10px 14px;font-size:.95rem;outline:none}
textarea{resize:vertical;min-height:96px}
input:focus,select:focus,textarea:focus{border-color:var(--brand2);box-shadow:0 0 0 4px color-mix(in srgb,var(--brand2) 16%,transparent)}
.phone-field{display:flex}.phone-field span{display:flex;align-items:center;padding:0 12px;border:1.5px solid var(--line);border-right:0;border-radius:14px 0 0 14px;background:var(--soft);font-weight:800}
.phone-field input{border-radius:0 14px 14px 0}
.pw-field{display:flex;align-items:center;gap:8px}.pw-field input{flex:1}.pw-field .link{padding:0 4px}
#anid{text-transform:uppercase;letter-spacing:.08em}
.chk{display:flex;gap:10px;align-items:flex-start;font-size:.85rem;margin:12px 0;font-weight:600}
.chk input{width:22px;height:22px;flex:none;accent-color:var(--brand2);margin:1px 0 0}
.notice{border-radius:16px;padding:11px 13px;font-size:.84rem;margin:10px 0;background:var(--policebg);color:var(--ink);display:block}
.notice svg{vertical-align:-3px;margin-right:2px}
.notice.err{background:var(--redbg);color:var(--red);font-weight:600}
.notice.ok{background:var(--greenbg);color:var(--green);font-weight:700}
.notice.warn{background:var(--amberbg);color:var(--ink)}
.notice.small{font-size:.76rem}
.fine{font-size:.78rem;color:var(--mut);margin:8px 0;line-height:1.5}
.fine svg{vertical-align:-2px}
.center{text-align:center}
.progress{height:6px;border-radius:6px;background:var(--soft);overflow:hidden;margin:8px 0}
.progress span{display:block;height:100%;background:var(--grad);transition:width .2s}

/* ---------- page headers (report, contacts, profile) ---------- */
.phead{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}
.phead h1{font-size:1.5rem;font-weight:800;letter-spacing:-.02em}
.phead small{display:block;font-size:.8rem;color:var(--mut);margin-top:3px}
.lbl{font-size:.72rem;font-weight:800;color:var(--mut);text-transform:uppercase;letter-spacing:.07em;margin:18px 2px 9px}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:16px;margin:12px 0;box-shadow:var(--shadow)}
.card h2{font-size:1.05rem;font-weight:800}
.card h3{display:flex;align-items:center;gap:7px;font-size:.95rem;font-weight:800;margin-bottom:10px}
.card h3.mt{margin-top:16px;margin-bottom:2px}
.card select{margin-top:2px}
.card-h{display:flex;align-items:center;justify-content:space-between}.card-h h3{margin:0}

/* ---------- report flow ---------- */
.steps{display:flex;gap:6px;margin-bottom:6px}.steps i{flex:1;height:5px;border-radius:5px;background:var(--line)}.steps i.on{background:var(--grad)}
.cats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.cats button{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 4px;border-radius:18px;background:var(--card);border:2px solid var(--line);font-size:.76rem;font-weight:700}
.cats button[aria-pressed=true]{border-color:var(--c);background:color-mix(in srgb,var(--c) 9%,var(--card))}
.loc-field{display:flex;gap:8px;align-items:center}.loc-field input{flex:1;min-width:0}.loc-field .chip{min-height:50px;border-radius:14px}
#report-map{height:230px;border-radius:20px;border:1px solid var(--line);overflow:hidden;position:relative;z-index:0;isolation:isolate}
.photos{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.ph{height:130px;border-radius:20px;overflow:hidden;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;font-size:.82rem;font-weight:700;color:var(--mut)}
.ph.add{border:2px dashed var(--line);background:var(--card)}
.ph.add.big{height:150px;color:var(--brand2)}
.ph.has img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ph.has span{position:absolute;left:8px;bottom:8px;display:flex;align-items:center;gap:4px;background:rgba(4,120,87,.92);color:#fff;border-radius:10px;padding:4px 8px;font-size:.72rem}
.ph.plain{background:var(--soft);padding:10px;text-align:center}
.row-links{display:flex;gap:16px;margin:8px 2px}
.summary .sheet-h{margin-bottom:10px}
.sum-img{width:100%;max-height:170px;object-fit:cover;border-radius:16px;display:block;margin-bottom:10px}
.facts{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.facts span{display:inline-flex;align-items:center;gap:5px;font-size:.76rem;font-weight:600;color:var(--mut);background:var(--soft);border-radius:10px;padding:5px 9px}
.desc{font-size:.9rem;line-height:1.55;white-space:pre-line;margin:6px 0}
.actionbar{position:fixed;left:12px;right:12px;bottom:calc(var(--safe-b) + 86px);display:flex;gap:10px;padding:8px;border-radius:22px;background:var(--bg);box-shadow:0 -10px 18px -8px var(--bg);z-index:25}
.actionbar .btn{margin:0}.actionbar .btn:not(.pri){flex:0 0 34%}
.done{text-align:center;padding-top:30px}
.done-ic{width:84px;height:84px;border-radius:50%;margin:0 auto 16px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,#10b981,#0e9f8f);box-shadow:0 14px 30px -12px rgba(16,185,129,.8)}
.done h1{font-size:1.6rem;font-weight:800}.done .lead{font-weight:700;margin:8px 0}

/* ---------- contacts ---------- */
.big3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.big3 a{text-decoration:none;text-align:center;border-radius:20px;padding:14px 6px;color:#fff;background:linear-gradient(160deg,color-mix(in srgb,var(--c) 85%,#fff),var(--c));box-shadow:0 12px 22px -14px var(--c)}
.big3 .b3i{width:36px;height:36px;border-radius:12px;background:rgba(255,255,255,.2);display:grid;place-items:center;margin:0 auto 6px}
.big3 em{display:block;font-style:normal;font-size:1.35rem;font-weight:800}
.big3 small{display:block;font-size:.68rem;font-weight:700;opacity:.92;line-height:1.25}
.list{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:4px 12px;box-shadow:var(--shadow)}
.list.flat{background:none;border:0;padding:0;box-shadow:none}
.row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink)}
.row:last-child{border-bottom:0}
.row-t{flex:1;min-width:0;font-size:.88rem;font-weight:700}
.row-t small{display:block;font-weight:500;font-size:.74rem;color:var(--mut)}
.num{font-weight:800;font-size:.85rem;color:var(--brand2);background:var(--policebg);border-radius:10px;padding:5px 10px}

/* ---------- profile ---------- */
.acct{display:flex;gap:14px;align-items:center}
.avatar{width:62px;height:62px;border-radius:50%;background:var(--grad);color:#fff;display:grid;place-items:center;font-weight:800;font-size:1.3rem;flex:none}
.card.center .avatar{margin:0 auto 10px}
.acct .pill{margin-top:6px}
.swrow{display:flex;align-items:center;gap:12px;padding:8px 0;cursor:pointer}
.sw{appearance:none;-webkit-appearance:none;width:48px;height:28px;border-radius:999px;background:var(--line);position:relative;flex:none;cursor:pointer;transition:background .2s}
.sw:after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s}
.sw:checked{background:var(--brand)}.sw:checked:after{transform:translateX(20px)}

/* ---------- sign-in ---------- */
.scr.auth{padding-bottom:30px}
.auth-hero{text-align:center;padding:18px 6px 6px}
.auth-hero h1{font-size:1.6rem;font-weight:800;letter-spacing:-.02em}
.auth-hero p{color:var(--mut);font-size:.9rem;margin-top:6px}
.auth-card{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:16px;margin-top:16px;box-shadow:var(--shadow)}
.auth-card .seg{margin:6px 0 4px}
.auth-card .btn.pri{margin-top:14px}
.fine.center{text-align:center}

/* ---------- floating tab bar ---------- */
.tabbar{position:absolute;left:12px;right:12px;bottom:calc(var(--safe-b) + 10px);height:68px;z-index:30;display:flex;justify-content:space-around;align-items:center;border-radius:24px;background:color-mix(in srgb,var(--card) 92%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--line);box-shadow:0 12px 30px -12px rgba(15,27,45,.35)}
.tabbar button{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:.66rem;font-weight:700;color:#94a3b8;min-width:56px;padding:6px 0}
.tabbar button[aria-current=page]{color:var(--brand)}
.tabbar .fab{width:58px;height:58px;min-width:0;border-radius:19px;margin-top:-34px;background:var(--grad);color:#fff;display:grid;place-items:center;box-shadow:0 12px 24px -8px rgba(37,99,235,.75);border:4px solid var(--bg)}
.tabbar .fab[aria-current=page]{color:#fff}
.toast{position:absolute;left:50%;bottom:calc(var(--safe-b) + 92px);transform:translateX(-50%);max-width:88%;background:var(--ink);color:var(--bg);padding:11px 16px;border-radius:14px;z-index:70;font-size:.85rem;font-weight:600;box-shadow:0 10px 24px -10px rgba(0,0,0,.4);text-align:center}

/* ---------- sheets and overlays ---------- */
.scrim{position:absolute;inset:0;background:rgba(10,18,32,.45);z-index:40;border:0}
.bsheet{position:absolute;left:0;right:0;bottom:0;z-index:45;background:var(--card);border-radius:28px 28px 0 0;padding:10px 18px calc(var(--safe-b) + 22px);max-height:86%;overflow:auto;box-shadow:0 -10px 40px -10px rgba(0,0,0,.3)}
.bsheet h3{font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--mut);margin:16px 0 8px}
.bsheet-h{display:flex;align-items:center;justify-content:space-between}.bsheet-h h2{font-size:1.2rem;font-weight:800}
.bsheet .seg{margin:0}
.grab{width:42px;height:5px;border-radius:5px;background:var(--line);margin:0 auto 12px}
.sheet-h{display:flex;align-items:center;gap:12px}
.sheet-h>div{flex:1;min-width:0}.sheet-h h2{font-size:1.02rem;font-weight:800;letter-spacing:-.01em}
.detail .hero{display:block;width:100%;height:200px;border-radius:20px;overflow:hidden;margin-bottom:14px}
.detail .hero img{width:100%;height:100%;object-fit:cover;display:block}
.detail .pills{margin:10px 0 2px}
.bsheet.prox{left:10px;right:10px;bottom:calc(var(--safe-b) + 88px);border-radius:26px;padding-bottom:12px;z-index:46}
.q{font-weight:800;font-size:.98rem;margin:12px 0 0}
.photo-modal{position:absolute;inset:0;z-index:80;background:rgba(0,0,0,.9);padding:16px;display:flex;flex-direction:column;justify-content:center;align-items:center}
.photo-modal img{max-width:100%;max-height:78%;border-radius:16px}
.photo-modal .btn{max-width:220px}

/* ---------- full-screen map ---------- */
.mapwrap{position:absolute;inset:0}
#map{position:absolute;inset:0;z-index:0;isolation:isolate;background:#dfe9f2}
.map-top{position:absolute;top:calc(var(--safe-t) + 12px);left:14px;right:14px;z-index:10}
.search{display:flex;align-items:center;gap:10px;height:52px;padding:0 8px 0 14px;border-radius:17px;background:var(--card);color:var(--mut);box-shadow:0 12px 26px -12px rgba(15,27,45,.45)}
.search input{flex:1;min-width:0;border:0;min-height:0;padding:0;background:none;box-shadow:none;font-size:.92rem}
.search input:focus{box-shadow:none}
.sug{margin-top:6px;border-radius:18px;background:var(--card);box-shadow:0 14px 30px -14px rgba(15,27,45,.5);overflow:hidden}
.sug:empty{display:none}
.sug button{display:flex;align-items:center;gap:10px;width:100%;padding:9px 12px;text-align:left;border-bottom:1px solid var(--line)}
.sug button:last-child{border-bottom:0}
.sug b{display:block;font-size:.86rem}.sug small{display:block;font-size:.72rem;color:var(--mut)}
.sug .none{padding:12px;font-size:.84rem;color:var(--mut)}
.mchips{display:flex;gap:7px;margin-top:9px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px}
.mchips::-webkit-scrollbar{display:none}
.mchips .chip{box-shadow:0 6px 14px -10px rgba(15,27,45,.5);border-color:transparent}
.mchips .chip:not(.on){opacity:.85}
.map-fabs{position:absolute;right:14px;top:calc(var(--safe-t) + 128px);z-index:10;display:flex;flex-direction:column;gap:8px}
.fabsm{width:44px;height:44px;border-radius:14px;background:var(--card);display:grid;place-items:center;box-shadow:0 8px 18px -8px rgba(15,27,45,.5);color:var(--ink)}
.map-note{position:absolute;left:50%;top:calc(var(--safe-t) + 132px);transform:translateX(-50%);z-index:10;background:var(--card);border-radius:12px;padding:7px 12px;font-size:.78rem;font-weight:600;box-shadow:var(--shadow)}
.map-note.err{color:var(--red)}
.map-note[hidden]{display:none}
#zoomhint{max-width:66%;text-align:center;font-size:.72rem;color:var(--mut)}
.msheet{position:absolute;left:12px;right:12px;bottom:calc(var(--safe-b) + 90px);z-index:20;background:var(--card);border-radius:26px;padding:10px 14px 14px;box-shadow:0 18px 40px -16px rgba(15,27,45,.55)}
.leaflet-control-attribution{font-size:9px!important;opacity:.75}
.mapwrap .leaflet-bottom{bottom:calc(var(--safe-b) + 82px)}

/* map symbols (src/icons.js) */
.cat-ic{display:inline-flex;align-items:center;justify-content:center;border-radius:50%;flex:none;vertical-align:middle;box-shadow:0 0 0 2px #fff,0 1px 3px rgba(0,0,0,.25)}
.ipin-wrap,.poi-wrap,.me-wrap{background:none;border:0}
.ipin{width:34px;height:34px;border-radius:50% 50% 50% 0;background:var(--c);transform:rotate(-45deg);border:2.5px solid #fff;box-shadow:0 4px 10px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center}
.ipin>span{transform:rotate(45deg);display:flex}
.ipin-old{opacity:.55;filter:saturate(.4)}
.ipin-police{box-shadow:0 0 0 3px #1d3a8a,0 4px 10px rgba(0,0,0,.35)}
.ipin-near{animation:pinpulse 1.4s ease-in-out infinite}
@keyframes pinpulse{0%,100%{box-shadow:0 0 0 0 rgba(37,99,235,.6),0 4px 10px rgba(0,0,0,.35)}50%{box-shadow:0 0 0 10px rgba(37,99,235,0),0 4px 10px rgba(0,0,0,.35)}}
.ipin-star{position:absolute;top:-14px;left:22px;font-size:16px;color:#f5b301;text-shadow:0 0 2px #000}
.poi{width:21px;height:21px;border-radius:7px;background:var(--c);border:2px solid #fff;box-shadow:0 2px 5px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center}
.poi-inline{display:inline-flex;width:18px;height:18px;border-radius:6px;vertical-align:middle;box-shadow:none;border:0}
.me-dot{width:20px;height:20px;border-radius:50%;background:#2563eb;border:3px solid #fff;box-shadow:0 0 0 7px rgba(37,99,235,.2),0 2px 6px rgba(0,0,0,.3)}

/* ---------- full-screen camera ---------- */
.camera-full{position:absolute;inset:0;z-index:90;background:#000;display:flex;flex-direction:column}
.camera-full video{flex:1;min-height:0;width:100%;object-fit:cover;background:#000}
.camera-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px calc(10px + var(--safe-b));background:#000}
.camera-bar .btn{width:auto;min-width:88px;margin:0;background:#222;color:#fff;border-color:#444}
.shutter{width:74px;height:74px;border-radius:50%;border:5px solid #fff;background:#fff;box-shadow:inset 0 0 0 4px #000;flex:none}
.shutter:active{transform:scale(.94)}
.cam-alt{color:#9fe3ea;text-align:center;padding:0 0 calc(10px + var(--safe-b));min-height:40px}

