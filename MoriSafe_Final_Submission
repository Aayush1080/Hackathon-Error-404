def test_duplicate_within_500_m_asks_for_confirmation_instead_of_rejecting(client):
    auth = login(client)
    lat, lng = spot()
    first = submit(client, lat, lng, cat="Fire").json()["report"]["id"]
    set_status(client, auth, first, "approved")
    near = submit(client, lat + 0.0018, lng, cat="Fire")  # ~200 m north
    err = near.json()["error"]
    assert near.status_code == 409 and err["code"] == "possible_duplicate"
    assert err["details"]["existing"]["id"] == first and 150 < err["details"]["existing"]["distance_m"] < 250
    assert submit(client, lat + 0.0018, lng, cat="Fire", confirm_distinct="true").status_code == 201  # a distinct fire
    assert submit(client, lat, lng, cat="Accident").status_code == 201        # different type, same spot
    assert submit(client, lat + 0.009, lng, cat="Fire").status_code == 201    # ~1 km away


