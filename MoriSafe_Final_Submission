# One image serves everything: public app at /, admin dashboard at /admin, API at /api.
# Stage 1 builds the two websites with Node; stage 2 runs the FastAPI server with Python.

FROM node:22-slim AS web
WORKDIR /build
COPY app/package.json app/package-lock.json app/
COPY admin/package.json admin/package-lock.json admin/
RUN cd app && npm ci --no-audit --no-fund && cd ../admin && npm ci --no-audit --no-fund
COPY app/ app/
COPY admin/ admin/
# No VITE_API_URL: the built sites call the server they are loaded from.
RUN rm -f app/.env admin/.env && cd app && npx vite build && cd ../admin && npx vite build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv
COPY server/requirements.txt .
RUN pip install -r requirements.txt
COPY server/ .
RUN rm -f .env
COPY --from=web /build/app/dist site/app
COPY --from=web /build/admin/dist site/admin
RUN useradd --create-home morisafe && chown -R morisafe /srv
USER morisafe
EXPOSE 8000
# Render sets $PORT. Proxy headers so rate limits see the real client IP behind Render's proxy.
CMD ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips '*'"]

# Render Blueprint: one web service serving the public app (/), admin dashboard (/admin) and API (/api).
# Render → New → Blueprint → pick this repo. It asks for the two Supabase values below.
# Free tier sleeps after ~15 min idle: open /api/health a minute before demoing.
services:
  - type: web
    name: morisafe
    runtime: docker
    dockerfilePath: ./Dockerfile
    plan: free
    region: singapore
    healthCheckPath: /api/health
    envVars:
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_SERVICE_ROLE_KEY
        sync: false
      - key: APP_SECRET
        generateValue: true
      # The app and dashboard are served from the same address, so they need no entry here.
      # These are the Android/iOS app and local development.
      - key: ALLOWED_ORIGINS
        value: https://localhost,capacitor://localhost,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Starts the MoriSafe API (:8000), admin website (:5173/admin) and public app (:5174), each in its own window.
# Run:  powershell -ExecutionPolicy Bypass -File start-all.ps1
$root = Split-Path -Parent $MyInvocation.MyCommand.Path
$py = Join-Path $root "server\.venv\Scripts\python.exe"

if (-not (Test-Path $py)) {
  Write-Host "Setting up the Python environment (first run only)..."
  $base = "$env:LOCALAPPDATA\Programs\Python\Python312\python.exe"
  if (-not (Test-Path $base)) { $base = "python" }
  & $base -m venv (Join-Path $root "server\.venv")
  & $py -m pip install -q -r (Join-Path $root "server\requirements.txt")
}
foreach ($d in "app", "admin") {
  if (-not (Test-Path (Join-Path $root "$d\node_modules"))) { Push-Location (Join-Path $root $d); npm install --no-audit --no-fund; Pop-Location }
}
if (-not (Test-Path (Join-Path $root "server\.env"))) {
  Copy-Item (Join-Path $root "server\.env.example") (Join-Path $root "server\.env")
  Write-Host "Created server\.env from the example. Fill in your Supabase URL, service_role key and APP_SECRET, then run this again." -ForegroundColor Yellow
  exit 1
}
if ((Get-Content (Join-Path $root "server\.env") -Raw) -match "replace-with") {
  Write-Host "server\.env still has placeholder values. Fill them in, then run this again." -ForegroundColor Red
  exit 1
}
if ((Get-Content (Join-Path $root "server\.env") -Raw) -match "PASTE-SERVICE-ROLE-KEY-HERE") {
  Write-Host "server\.env still needs your Supabase service_role key. Paste it in, then run this again." -ForegroundColor Red
  exit 1
}

Start-Process powershell -ArgumentList "-NoExit", "-Command", "cd '$root\server'; & '$py' -m uvicorn server:app --host 0.0.0.0 --port 8000"
Start-Process powershell -ArgumentList "-NoExit", "-Command", "cd '$root\admin'; npx vite --port 5175"
Start-Process powershell -ArgumentList "-NoExit", "-Command", "cd '$root\app'; npm run dev"

Start-Sleep 4
Write-Host ""
Write-Host "API health:      http://localhost:8000/api/health"
Write-Host "Admin website:   http://localhost:5175/admin"
Write-Host "Public app:      http://localhost:5174"
Start-Process "http://localhost:5175/admin"

# Makes MoriSafe reachable from any phone over HTTPS, while this PC is on.
#   App:   https://<random>.trycloudflare.com/
#   Admin: https://<random>.trycloudflare.com/admin
# Run:  powershell -ExecutionPolicy Bypass -File start-phone.ps1     (Ctrl+C or close the windows to stop)
# The link changes every time this script starts.
$ErrorActionPreference = "Stop"
$root = Split-Path -Parent $MyInvocation.MyCommand.Path
$py = Join-Path $root "server\.venv\Scripts\python.exe"

if ((Get-Content (Join-Path $root "server\.env") -Raw) -match "PASTE-SERVICE-ROLE-KEY-HERE") {
  Write-Host "server\.env still needs your Supabase service_role key." -ForegroundColor Red; exit 1
}
$cf = (Get-Command cloudflared -ErrorAction SilentlyContinue).Source
if (-not $cf) { $cf = @("C:\Program Files (x86)\cloudflared\cloudflared.exe", "C:\Program Files\cloudflared\cloudflared.exe") | Where-Object { Test-Path $_ } | Select-Object -First 1 }
if (-not $cf) { Write-Host "Installing cloudflared..."; winget install -e --id Cloudflare.cloudflared --silent --accept-package-agreements --accept-source-agreements; $cf = "C:\Program Files (x86)\cloudflared\cloudflared.exe" }

# 1. Build the app and dashboard so the server can serve them (same address = no extra setup).
Write-Host "Building the app and admin website..."
# --mode phone loads .env.phone, which blanks VITE_API_URL (PowerShell cannot set an empty env var).
foreach ($d in "app", "admin") {
  Push-Location (Join-Path $root $d)
  if (-not (Test-Path node_modules)) { npm install --no-audit --no-fund | Out-Null }
  npx vite build --mode phone | Out-Null
  Pop-Location
}
$site = Join-Path $root "server\site"
if (Test-Path $site) { Remove-Item -Recurse -Force $site }
New-Item -ItemType Directory $site | Out-Null
Copy-Item -Recurse (Join-Path $root "app\dist") (Join-Path $site "app")
Copy-Item -Recurse (Join-Path $root "admin\dist") (Join-Path $site "admin")

# 2. Server, only reachable from this PC; the tunnel is the way in. Trust forwarded client IPs from the tunnel only.
$busy = Get-NetTCPConnection -LocalPort 8000 -State Listen -ErrorAction SilentlyContinue
if ($busy) { Write-Host "Port 8000 is already in use. Close the other MoriSafe server window first." -ForegroundColor Red; exit 1 }
Start-Process powershell -ArgumentList "-NoExit", "-Command", "cd '$root\server'; & '$py' -m uvicorn server:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1"
Start-Sleep 4

# 3. HTTPS tunnel. Print the address once cloudflared reports it.
$log = Join-Path $env:TEMP "morisafe-tunnel.log"
if (Test-Path $log) { Remove-Item $log }
Start-Process $cf -ArgumentList "tunnel", "--no-autoupdate", "--url", "http://127.0.0.1:8000", "--logfile", "`"$log`"" -WindowStyle Minimized
$url = $null
for ($i = 0; $i -lt 60 -and -not $url; $i++) {
  Start-Sleep 1
  if (Test-Path $log) { $m = Select-String -Path $log -Pattern "https://[a-z0-9-]+\.trycloudflare\.com" | Select-Object -First 1; if ($m) { $url = $m.Matches[0].Value } }
}
if (-not $url) { Write-Host "The tunnel did not start. See $log" -ForegroundColor Red; exit 1 }
Set-Clipboard $url
Write-Host ""
Write-Host "MoriSafe is online:" -ForegroundColor Green
Write-Host "  Phones (app):  $url"
Write-Host "  Admin:         $url/admin"
Write-Host "  (link copied to clipboard; it stays up while this PC and the two windows are running)"
Start-Process "$url/admin"

# Address of the MoriSafe API server (no trailing slash). Baked in at build time.
VITE_API_URL=http://localhost:8000

