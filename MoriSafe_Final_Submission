.calls a em{display:block;font-style:normal;font-size:1.05rem;font-weight:800}
.calls a:active{background:rgba(255,255,255,.3)}

/* ---------- segmented control, chips, section row ---------- */
.seg{display:flex;background:var(--soft);border-radius:15px;padding:4px;margin:14px 0}
.seg button{flex:1;padding:9px 4px;border-radius:11px;font-size:.82rem;font-weight:700;color:var(--mut)}
.seg button[aria-pressed=true]{background:var(--card);color:var(--ink);box-shadow:0 2px 6px rgba(15,27,45,.1)}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 12px;border-radius:12px;background:var(--card);border:1px solid var(--line);font-size:.8rem;font-weight:700;white-space:nowrap}
.chip.on,.chip[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.sec{display:flex;align-items:center;gap:7px;margin:2px 2px 10px}
.sec h2{flex:1;font-size:1rem;font-weight:800;letter-spacing:-.01em}

/* ---------- incident cards ---------- */
.tile{display:inline-grid;place-items:center;border-radius:30%;flex:none;background:color-mix(in srgb,var(--c) 14%,var(--card))}
.tile.ok{--c:#10b981}
.inc{display:grid;grid-template-columns:1fr auto;gap:0 10px;background:var(--card);border:1px solid var(--line);border-radius:22px;padding:12px;margin-bottom:10px;box-shadow:var(--shadow)}
.inc.dim{opacity:.62}
.inc-main{display:flex;gap:12px;text-align:left;min-width:0;align-items:flex-start}
.inc-t{display:flex;flex-direction:column;min-width:0}
.inc-t b{font-size:.92rem;font-weight:800;letter-spacing:-.01em;line-height:1.3}
.m{font-size:.76rem;color:var(--mut);margin-top:2px}
.pills{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}
.pill{display:inline-flex;align-items:center;gap:4px;font-size:.66rem;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap}
.p-pol{background:var(--policebg);color:var(--police)}.p-cit{background:var(--greenbg);color:var(--green)}
.p-new{background:var(--amberbg);color:var(--amber)}.p-old{background:var(--soft);color:var(--mut)}.p-tr{background:var(--soft);color:var(--brand2)}
.thumb{width:66px;height:66px;border-radius:16px;overflow:hidden;background:var(--soft)}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.inc-d{grid-column:1/-1;font-size:.82rem;color:var(--mut);margin-top:9px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-line}
.empty{text-align:center;background:var(--card);border:1px solid var(--line);border-radius:24px;padding:26px 18px;box-shadow:var(--shadow)}
.empty .tile{margin-bottom:10px}.empty h3{font-size:1.02rem;font-weight:800}.empty p{font-size:.85rem;color:var(--mut);margin:4px 0 14px}
.skel{height:92px;border-radius:22px;margin-bottom:10px;background:linear-gradient(90deg,var(--soft),var(--card),var(--soft));background-size:200% 100%;animation:sk 1.2s infinite}
@keyframes sk{to{background-position:-200% 0}}

/* ---------- buttons, fields, notices ---------- */
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:52px;padding:0 16px;margin:8px 0;border-radius:16px;background:var(--card);border:1px solid var(--line);font-weight:700;font-size:.95rem;text-decoration:none;color:var(--ink)}
.btn.pri{background:var(--grad);border:0;color:#fff;box-shadow:0 12px 24px -12px rgba(37,99,235,.75)}
