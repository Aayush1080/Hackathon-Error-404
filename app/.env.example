# Copy to .env. Baked in at build time (vite build), so rebuild after changing.
# HTTPS address of the deployed API server (no trailing slash). A phone cannot reach "localhost".
VITE_API_URL=https://morisafe-api.onrender.com
# true only after adding android/app/google-services.json from Firebase (see README).
# Registering for push without it crashes the Android app on start.
VITE_PUSH_ENABLED=false
